---
// What the Mac app code does with screen, voice, and data.
// Not the legal privacy policy (src/pages/privacy.astro).
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import NonMacWaitlist from '../components/NonMacWaitlist.astro';
import { trackedDownloadUrl } from '../data/config.ts';
import { privacyFacts, privacyPage } from '../data/privacyFacts.ts';

const downloadHref = trackedDownloadUrl('privacy', 'privacy_first', 'download');
---
<Layout title={privacyPage.title} description={privacyPage.description} productLine="people" funnelStage="consideration">
  <Nav />
  <main class="overflow-x-clip">
    <article class="mx-auto max-w-[820px] px-6 pb-20 pt-32 lg:pt-40">
      <p class="text-[11px] font-mono uppercase tracking-[0.08em] text-amber-700">Privacy</p>
      <h1 class="mt-4 text-4xl font-bold leading-[1.1] tracking-tight text-gray-900 sm:text-5xl">
        {privacyPage.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-gray-600">
        This page is what the Mac app code shows. It is not the legal privacy policy.
        That page is <a href="/privacy/" class="font-medium text-gray-900 underline underline-offset-2">here</a>.
      </p>
      <p class="mt-4 text-[15px] leading-relaxed text-gray-600">
        Skilly points at a control. It never clicks, and it never moves your cursor.
        Bring your own OpenAI key is $5/month plus your OpenAI usage.
        The setup steps are in the
        <a href="/learn/skilly-openai-key-setup/" class="font-medium text-gray-900 underline underline-offset-2">OpenAI key guide</a>.
      </p>

      <div class="mt-10 flex flex-col gap-6">
        {privacyFacts.map((fact) => (
          <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
            <h2 class="text-xl font-semibold text-gray-900">{fact.title}</h2>
            <p class="mt-3 text-[15px] leading-relaxed text-gray-700">{fact.detail}</p>
            <ul class="mt-4 flex flex-col gap-1.5 text-[14px]">
              {fact.sources.map((source) => (
                <li>
                  <a href={source.href} class="text-amber-800 underline decoration-amber-300 underline-offset-2 hover:decoration-amber-600" rel="noopener noreferrer">
                    {source.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <section class="mt-10 rounded-2xl border border-amber-200/70 bg-amber-50/70 p-6">
        <h2 class="text-xl font-semibold text-gray-900">Try it on your Mac</h2>
        <p class="mt-2 text-[15px] leading-relaxed text-gray-700">
          15-minute trial, no card. macOS 14.2 or later.
        </p>
        <NonMacWaitlist id="get-skilly" location="privacy_first" class="mt-4" />
        <div class="mt-4" data-mac-download>
          <Button
            href={downloadHref}
            variant="people-primary"
            size="lg"
            data-ph-event="web_cta_download_clicked"
            data-ph-prop-location="privacy_first"
            data-ph-prop-target-funnel="people"
            data-ph-prop-cta-text="Download for Mac"
          >
            Download for Mac
          </Button>
        </div>
      </section>
    </article>
  </main>
  <Footer />
</Layout>
