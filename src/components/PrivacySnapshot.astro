---
// Ten-second privacy snapshot. Wording comes from src/data/privacyFacts.ts.
import { privacyFacts } from '../data/privacyFacts.ts';

const snapshotIds = ['screen', 'voice', 'destination', 'license'];
const snapshot = privacyFacts.filter((fact) => snapshotIds.includes(fact.id));
---
<section id="privacy" class="mx-auto max-w-[1360px] px-5 pb-10 sm:px-8" aria-labelledby="privacy-snapshot-heading">
  <div class="rounded-[26px] border border-[#f0ddd4] bg-white px-6 py-7 shadow-[0_12px_32px_rgba(111,73,48,0.05)] sm:px-8">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-[720px]">
        <h2 id="privacy-snapshot-heading" class="text-[32px] font-bold leading-[1.05] tracking-[-0.04em] text-[#2a2421] sm:text-[36px]">
          How Skilly handles your data
        </h2>
        <p class="mt-3 text-[15px] leading-[1.6] text-[#5f534d]">
          Bring your own OpenAI key is $5/month plus your OpenAI usage.
        </p>
      </div>
      <a
        href="/privacy-first/"
        data-ph-event="web_learn_related_clicked"
        data-ph-prop-location="home_privacy_snapshot"
        data-ph-prop-target-article="privacy-first"
        class="shrink-0 text-[15px] font-semibold text-[#c2410c] underline decoration-[#f0c3ad] underline-offset-4 hover:decoration-[#c2410c]"
      >
        Read the details
      </a>
    </div>
    <dl class="mt-6 grid gap-4 sm:grid-cols-2">
      {snapshot.map((fact) => (
        <div class="rounded-2xl bg-[#fff8f4] px-4 py-4">
          <dt class="text-[14px] font-semibold text-[#2a2421]">{fact.title}</dt>
          <dd class="mt-1 text-[14px] leading-[1.55] text-[#5f534d]">{fact.summary}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
