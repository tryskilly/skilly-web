---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Badge from '../components/Badge.astro';
import Footer from '../components/Footer.astro';
import SkillyWebWidget from '../components/SkillyWebWidget.astro';
import {
  ArrowRight,
  ArrowUpRight,
  BadgeCheck,
  ChartNoAxesColumn,
  ChevronRight,
  CircleHelp,
  CircleX,
  Clock,
  Database,
  Code2,
  CreditCard,
  FileText,
  Frown,
  GraduationCap,
  Headset,
  House,
  LayoutDashboard,
  Lock,
  Map,
  MessageSquareDot,
  Mic,
  MousePointerClick,
  Redo2,
  RefreshCw,
  Rocket,
  Settings,
  ShieldCheck,
  Snowflake,
  SquareCode,
  Target,
  VolumeX,
  X,
} from 'lucide-astro';

const BOOKING_URL = 'https://cal.com/moelabs.dev';
const AUDIT_URL = '/tools/ai-onboarding-audit/';
const DEFAULT_DEMO_GOAL = 'Guide a new user to connect data, create a workspace, and invite a teammate.';

const comparisonRows = [
  { label: 'Answers follow-up questions', tour: 'x', chatbot: 'check', skilly: 'check' },
  { label: 'Understands current page', tour: 'x', chatbot: 'warn', skilly: 'check' },
  { label: 'Points to exact UI action', tour: 'warn', chatbot: 'x', skilly: 'check' },
  { label: "Adapts to user's question", tour: 'x', chatbot: 'warn', skilly: 'check' },
  { label: 'Measures completed tasks', tour: 'warn', chatbot: 'warn', skilly: 'check' },
];

const pricingFacts = [
  { name: 'Early Access', value: '$0', detail: '30 teaching minutes per month' },
  { name: 'Starter', value: '$29', detail: '400 teaching minutes per month' },
  { name: 'Studio', value: '$99', detail: '1,500 teaching minutes per month' },
  { name: 'Scale', value: '$299', detail: '5,000 teaching minutes per month' },
];
---
<Layout
  title="Skilly: Voice onboarding for SaaS and apps"
  description="Skilly adds voice-and-pointer onboarding to websites and SaaS products, helping users answer what to do and finish setup."
  productLine="builders"
  funnelStage="conversion"
>
  <Nav />

  <main class="overflow-x-clip bg-[#FEFDFB] text-[#161515]">
    <div class="sr-only" itemscope itemtype="https://schema.org/SoftwareApplication">
      <span itemprop="name">Skilly for Builders</span>
      <p itemprop="description">
        Skilly is an embeddable voice-and-pointer assistant for onboarding flows, product education, and activation inside websites and SaaS products.
      </p>
      <span itemprop="applicationCategory">BusinessApplication</span>
    </div>

    <section class="builders-hero relative border-b border-[var(--marketing-border)] bg-[var(--marketing-canvas)]">
      <div class="absolute inset-x-0 top-0 h-[520px] bg-[#FEFDFB]"></div>
      <div class="builders-hero-inner relative mx-auto max-w-[1360px] px-5 pb-8 pt-20 md:px-6 md:pb-[8.75rem] md:pt-[4.5rem]">
        <div class="builders-hero-grid grid items-center gap-8 md:grid-cols-[minmax(0,610px)_minmax(0,1fr)]">
          <div class="builders-hero-copy max-w-[610px]">
            <div class="inline-flex rounded-full border border-[var(--marketing-accent-border)] bg-white/90 px-4 py-2 text-[12px] font-semibold uppercase tracking-[0.04em] text-[var(--marketing-accent)]">
              AI onboarding for complex products
            </div>

            <h1 class="builders-hero-title mt-5 max-w-[610px] text-[41px] font-bold leading-[0.96] tracking-[-0.05em] text-[#161515] md:text-[58px]">
              Voice onboarding for{' '}<br class="hidden md:block" />complex <span class="text-[var(--marketing-accent)]">products.</span>
            </h1>

            <p class="mt-5 max-w-[550px] text-[16px] leading-[1.48] text-[#5F584F] md:text-[17.5px]">
              A voice-first AI guide that talks users through your product, understands what they are seeing, and points to exactly what they should click next.
            </p>

            <div class="builders-hero-actions mt-6 flex flex-wrap gap-2.5">
              <a
                href={AUDIT_URL}
                data-ph-event="web_nav_link_clicked"
                data-ph-prop-link="ai_onboarding_audit"
                data-ph-prop-location="builders_hero_primary"
                data-ph-prop-target-funnel="builders"
                class="inline-flex min-h-11 items-center justify-center rounded-[12px] bg-[#161515] px-[18px] py-2.5 text-[14px] font-semibold text-white shadow-[0_10px_22px_rgba(22,21,21,0.14)] transition hover:bg-[#252321] active:translate-y-px"
              >
                Generate a guide for my product
                <ArrowRight size={15} strokeWidth={1.8} class="ml-2" aria-hidden="true" />
              </a>
              <button
                type="button"
                data-builders-widget-demo
                data-ph-event="web_builders_widget_demo_clicked"
                data-ph-prop-location="builders_hero_secondary"
                data-ph-prop-target-funnel="builders"
                class="inline-flex min-h-11 items-center justify-center rounded-[12px] border border-[#D7D0C4] bg-white px-[18px] py-2.5 text-[14px] font-semibold text-[#161515] transition hover:border-[var(--marketing-accent)] active:translate-y-px"
              >
                Try Skilly on this page
              </button>
            </div>

            <div class="builders-hero-assurances mt-6 flex flex-wrap gap-x-4 gap-y-2 text-[12px] text-[#6A6257]">
              <div class="inline-flex items-center gap-2">
                <BadgeCheck size={15} strokeWidth={1.8} class="text-[#8A816F]" aria-hidden="true" />
                No signup for preview
              </div>
              <div class="inline-flex items-center gap-2">
                <Clock size={15} strokeWidth={1.8} class="text-[#8A816F]" aria-hidden="true" />
                Takes 2 minutes
              </div>
              <div class="inline-flex items-center gap-2">
                <CreditCard size={15} strokeWidth={1.8} class="text-[#8A816F]" aria-hidden="true" />
                No credit card
              </div>
            </div>
          </div>

          <div class="builders-hero-scene relative md:pl-2">
            <div class="hero-product-card relative flex min-h-[580px] max-w-[550px] flex-col rounded-[24px] border border-[#E5DDD0] bg-[#F8F5EF] p-3 shadow-[0_24px_64px_rgba(41,33,20,0.10)] md:-translate-x-[84px]">
              <div class="rounded-[20px] border border-[#DFD5C7] bg-white shadow-[inset_0_1px_0_rgba(255,255,255,0.8)]">
                <div class="acme-titlebar flex items-center gap-2 border-b border-[#EAE2D6] px-3.5 py-2.5">
                  <span class="h-2.5 w-2.5 rounded-full bg-[#D9CDC0]"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-[#E7DDD1]"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-[#EFE7DC]"></span>
                  <span class="ml-2.5 text-[12px] font-semibold text-[#47413A]">Acme Analytics</span>
                </div>

                <div class="acme-body grid min-h-[470px] gap-0 md:grid-cols-[102px_minmax(0,1fr)]">
                  <aside class="border-b border-r border-[#EAE2D6] bg-[#FAF8F4] px-3.5 py-4 md:border-b-0">
                    <div class="acme-nav space-y-3.5 text-[11px] text-[#71695F]">
                      <div class="flex items-center gap-2 font-medium text-[#262320]"><House size={13} strokeWidth={1.8} aria-hidden="true" />Home</div>
                      <div class="flex items-center gap-2 font-medium text-[#262320]"><LayoutDashboard size={13} strokeWidth={1.8} aria-hidden="true" />Dashboards</div>
                      <div class="flex items-center gap-2 font-medium text-[#262320]"><FileText size={13} strokeWidth={1.8} aria-hidden="true" />Reports</div>
                      <div class="flex items-center gap-2 rounded-[10px] bg-[#ECE7DF] px-2.5 py-2 font-semibold text-[#262320]"><Database size={13} strokeWidth={1.8} aria-hidden="true" />Data</div>
                      <div class="flex items-center gap-2 font-medium text-[#262320]"><Settings size={13} strokeWidth={1.8} aria-hidden="true" />Settings</div>
                    </div>
                  </aside>

                  <div class="acme-main flex flex-col px-4 py-4">
                    <p class="text-[14px] font-semibold text-[#161515]">Connect your data</p>
                    <p class="mt-1 text-[11px] text-[#6F675C]">Choose a data source to get started.</p>

                    <div class="acme-source-list mt-3 space-y-2.5">
                      <div class="flex items-center justify-between rounded-[16px] border border-[#E7E0D5] bg-[#FCFBF8] px-3.5 py-2.5 shadow-[0_10px_18px_rgba(28,22,15,0.04)]">
                        <div class="flex items-center gap-3">
                          <div class="grid h-9 w-9 place-items-center rounded-[11px] bg-[#EDF2FF] text-[#3851A6]"><Database size={20} strokeWidth={1.8} aria-hidden="true" /></div>
                          <div>
                            <p class="text-[13px] font-semibold text-[#161515]">PostgreSQL</p>
                            <p class="text-[11px] text-[#7D7468]">Connect your PostgreSQL database.</p>
                          </div>
                        </div>
                        <button class="hero-connect-button is-highlighted" type="button">Connect</button>
                      </div>

                      <div class="flex items-center justify-between rounded-[16px] border border-[#E7E0D5] bg-[#FCFBF8] px-3.5 py-2.5">
                        <div class="flex items-center gap-3">
                          <div class="grid h-9 w-9 place-items-center rounded-[11px] bg-[#EEF4FF] text-[#406DD7]"><ChartNoAxesColumn size={20} strokeWidth={1.8} aria-hidden="true" /></div>
                          <div>
                            <p class="text-[13px] font-semibold text-[#161515]">BigQuery</p>
                            <p class="text-[11px] text-[#7D7468]">Connect your BigQuery project.</p>
                          </div>
                        </div>
                        <button class="hero-connect-button" type="button">Connect</button>
                      </div>

                      <div class="flex items-center justify-between rounded-[16px] border border-[#E7E0D5] bg-[#FCFBF8] px-3.5 py-2.5">
                        <div class="flex items-center gap-3">
                          <div class="grid h-9 w-9 place-items-center rounded-[11px] bg-[#ECF9FA] text-[#1593A0]"><Snowflake size={20} strokeWidth={1.8} aria-hidden="true" /></div>
                          <div>
                            <p class="text-[13px] font-semibold text-[#161515]">Snowflake</p>
                            <p class="text-[11px] text-[#7D7468]">Connect your Snowflake account.</p>
                          </div>
                        </div>
                        <button class="hero-connect-button" type="button">Connect</button>
                      </div>
                    </div>

                    <div class="acme-footer mt-auto flex items-center justify-between pt-4 text-[11px] text-[#6E665B]">
                      <span>Need help choosing?</span>
                      <span class="inline-flex items-center gap-1 font-medium text-[#4F483F]">View our docs <ArrowRight size={12} strokeWidth={1.8} aria-hidden="true" /></span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="hero-caption">
                <Redo2 size={52} strokeWidth={0.65} class="shrink-0 text-[#6D665B]" aria-hidden="true" />
                <p class="text-[12px] leading-[1.4] text-[#3D3833]">
                  Skilly speaks, understands the page,
                  <br />
                  and points to the next action.
                </p>
              </div>
            </div>

            <div class="hero-widget-card">
              <div class="hero-widget-header flex items-center justify-between">
                <span class="font-bold tracking-[-0.04em] text-[var(--marketing-text)]">skilly</span>
                <div class="flex items-center gap-3 text-[var(--marketing-muted)]">
                  <ArrowUpRight size={15} strokeWidth={1.8} aria-hidden="true" />
                  <X size={15} strokeWidth={1.8} aria-hidden="true" />
                </div>
              </div>

              <div class="hero-widget-progress mt-5 flex items-center justify-between text-[12px] text-[#332F2B]">
                <span class="font-semibold">Step 1 of 3</span>
                <div class="flex items-center gap-1.5">
                  <span class="h-2 w-2 rounded-full bg-[var(--marketing-accent)]"></span>
                  <span class="h-1.5 w-7 rounded-full bg-[#E7DFD3]"></span>
                  <span class="h-1.5 w-7 rounded-full bg-[#E7DFD3]"></span>
                </div>
              </div>

              <div class="hero-widget-user-card mt-5 rounded-[16px] bg-[#F4F1EC] px-4 py-3 text-[#746B5F]">
                <span>(You spoken)</span>
                <p class="text-[#1A1714]">How do I connect my database?</p>
                <time>0:04</time>
              </div>

              <div class="hero-widget-voice-meta mt-4 flex items-center justify-between text-[12px]">
                <span class="font-semibold text-[var(--marketing-accent)]">Voice reply</span>
                <span class="text-[#8A8175]">Speaking...</span>
              </div>

              <p class="hero-widget-answer mt-3 text-[14px] leading-[1.55] text-[#3E3934]">
                Choose PostgreSQL here.<br />I'll guide you through<br />the next step.
              </p>

              <div class="hero-widget-waveform mt-5 flex h-[64px] items-center justify-center gap-[3px]">
                {[18, 28, 42, 58, 46, 64, 38, 53, 34, 45, 30, 40, 26, 22, 27, 35, 29, 38, 46, 52, 60, 48, 40, 32, 24, 18].map((height, index) => (
                  <span class={index > 12 ? 'voice-bar is-muted' : 'voice-bar'} style={`height:${height}px`}></span>
                ))}
              </div>

              <div class="hero-widget-mic mx-auto mt-5 grid h-20 w-20 place-items-center rounded-full border border-[#F2CB7B] bg-[#FFF2D8] shadow-[0_0_0_10px_rgba(245,158,11,0.11)]">
                <span class="grid h-14 w-14 place-items-center rounded-full border border-[#E6A421] bg-[#FFE6B2] text-[#1A1714]"><Mic size={20} strokeWidth={1.8} fill="#1A1714" aria-hidden="true" /></span>
              </div>

              <div class="hero-widget-controls mt-5 grid grid-cols-3 text-center text-[12px] text-[#3D3934]">
                <div class="flex flex-col items-center justify-center gap-2"><VolumeX size={16} strokeWidth={1.8} aria-hidden="true" /><span>Mute</span></div>
                <div class="flex flex-col items-center justify-center gap-2"><RefreshCw size={16} strokeWidth={1.8} aria-hidden="true" /><span>Replay</span></div>
                <div class="flex flex-col items-center justify-center gap-2"><Mic size={16} strokeWidth={1.8} aria-hidden="true" /><span>Mic on</span></div>
              </div>
            </div>

            <span class="hero-guidance-path" aria-hidden="true"></span>
            <img class="hero-scene-pointer" src="/skilly-mark.png" width="72" height="72" alt="" loading="eager" decoding="async" />
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-[var(--marketing-border)] bg-[var(--marketing-section)]">
      <div class="builders-section-inner builders-problem-inner mx-auto max-w-[1360px] px-5 py-7 md:px-6 md:py-12">
        <h2 class="builders-problem-title mx-auto max-w-[18ch] text-center text-[24px] font-bold leading-[1.16] tracking-[-0.04em] text-[var(--marketing-text)] md:text-[28px]">
          Your users don’t complain when onboarding fails. They <span class="text-[var(--marketing-accent)]">disappear.</span>
        </h2>

        <div class="builders-problem-grid mt-5 grid gap-3 md:grid-cols-4">
          <article class="rounded-[18px] border border-[var(--marketing-surface-border)] bg-white px-4 py-6 text-center shadow-[var(--marketing-shadow-card)]">
            <div class="mx-auto grid h-14 w-14 place-items-center rounded-full border border-[var(--marketing-border)] bg-[var(--marketing-section)] text-[#201D1A]">
              <Frown size={28} strokeWidth={1.8} aria-hidden="true" />
            </div>
            <h3 class="mt-3 text-[16px] font-semibold tracking-[-0.02em] text-[var(--marketing-text)]">Users get stuck</h3>
            <p class="mt-1.5 text-[13px] leading-[1.45] text-[var(--marketing-muted)]">Complex products overwhelm new users early.</p>
          </article>

          <article class="rounded-[18px] border border-[var(--marketing-surface-border)] bg-white px-4 py-6 text-center shadow-[var(--marketing-shadow-card)]">
            <div class="mx-auto grid h-14 w-14 place-items-center rounded-full border border-[var(--marketing-border)] bg-[var(--marketing-section)] text-[#201D1A]">
              <Map size={28} strokeWidth={1.8} aria-hidden="true" />
            </div>
            <h3 class="mt-3 text-[16px] font-semibold tracking-[-0.02em] text-[var(--marketing-text)]">Static tours fall short</h3>
            <p class="mt-1.5 text-[13px] leading-[1.45] text-[var(--marketing-muted)]">Linear flows can’t adapt to real questions.</p>
          </article>

          <article class="rounded-[18px] border border-[var(--marketing-surface-border)] bg-white px-4 py-6 text-center shadow-[var(--marketing-shadow-card)]">
            <div class="mx-auto grid h-14 w-14 place-items-center rounded-full border border-[var(--marketing-border)] bg-[var(--marketing-section)] text-[#201D1A]">
              <MessageSquareDot size={28} strokeWidth={1.8} aria-hidden="true" />
            </div>
            <h3 class="mt-3 text-[16px] font-semibold tracking-[-0.02em] text-[var(--marketing-text)]">Chatbots can’t point</h3>
            <p class="mt-1.5 text-[13px] leading-[1.45] text-[var(--marketing-muted)]">They answer, but can’t show exactly what to click.</p>
          </article>

          <article class="rounded-[18px] border border-[var(--marketing-surface-border)] bg-white px-4 py-6 text-center shadow-[var(--marketing-shadow-card)]">
            <div class="mx-auto grid h-14 w-14 place-items-center rounded-full border border-[var(--marketing-border)] bg-[var(--marketing-section)] text-[#201D1A]">
              <Headset size={28} strokeWidth={1.8} aria-hidden="true" />
            </div>
            <h3 class="mt-3 text-[16px] font-semibold tracking-[-0.02em] text-[var(--marketing-text)]">Support sees the aftermath</h3>
            <p class="mt-1.5 text-[13px] leading-[1.45] text-[var(--marketing-muted)]">Your team becomes the fallback plan.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="how" class="border-b border-[var(--marketing-border)] bg-[var(--marketing-section)]">
      <div class="builders-section-inner builders-how-inner mx-auto max-w-[1360px] px-5 py-6 md:px-6 md:py-11">
        <h2 class="text-center text-[25px] font-bold tracking-[-0.04em] text-[var(--marketing-text)] md:text-[27px]">How Skilly works</h2>

        <div class="mt-6 grid gap-4 md:grid-cols-4 md:gap-2.5">
          <article class="relative text-center">
            <div class="how-step-dot">1</div>
            <div class="how-step-line hidden md:block"></div>
            <div class="how-step-icon mx-auto mt-5 grid h-14 w-14 place-items-center rounded-full text-[#221E19]">
              <GraduationCap size={29} strokeWidth={1.8} aria-hidden="true" />
            </div>
            <h3 class="mt-2.5 text-[16px] font-semibold tracking-[-0.03em] text-[var(--marketing-text)]">Teach Skilly</h3>
            <p class="mt-1.5 text-[13px] leading-[1.45] text-[var(--marketing-muted)]">Show Skilly your product and key activation tasks.</p>
          </article>

          <article class="relative text-center">
            <div class="how-step-dot">2</div>
            <div class="how-step-line hidden md:block"></div>
            <div class="how-step-icon mx-auto mt-5 grid h-14 w-14 place-items-center rounded-full text-[#221E19]">
              <Target size={29} strokeWidth={1.8} aria-hidden="true" />
            </div>
            <h3 class="mt-2.5 text-[16px] font-semibold tracking-[-0.03em] text-[var(--marketing-text)]">Choose an activation goal</h3>
            <p class="mt-1.5 text-[13px] leading-[1.45] text-[var(--marketing-muted)]">Pick the outcome you want users to achieve.</p>
          </article>

          <article class="relative text-center">
            <div class="how-step-dot">3</div>
            <div class="how-step-line hidden md:block"></div>
            <div class="how-step-icon mx-auto mt-5 grid h-14 w-14 place-items-center rounded-full text-[#221E19]">
              <MousePointerClick size={29} strokeWidth={1.8} aria-hidden="true" />
            </div>
            <h3 class="mt-2.5 text-[16px] font-semibold tracking-[-0.03em] text-[var(--marketing-text)]">Preview it on your product</h3>
            <p class="mt-1.5 text-[13px] leading-[1.45] text-[var(--marketing-muted)]">See Skilly guide users and point to UI actions.</p>
          </article>

          <article class="relative text-center">
            <div class="how-step-dot">4</div>
            <div class="how-step-icon mx-auto mt-5 grid h-14 w-14 place-items-center rounded-full text-[#221E19]">
              <SquareCode size={29} strokeWidth={1.8} aria-hidden="true" />
            </div>
            <h3 class="mt-2.5 text-[16px] font-semibold tracking-[-0.03em] text-[var(--marketing-text)]">Install in one script</h3>
            <p class="mt-1.5 text-[13px] leading-[1.45] text-[var(--marketing-muted)]">Add a snippet and go live in minutes.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="use-cases" class="border-b border-[var(--marketing-border)] bg-[var(--marketing-section)]">
      <div class="builders-section-inner builders-impact-inner mx-auto max-w-[1360px] px-5 py-7 md:px-6 md:py-8">
        <div class="builders-impact-grid grid items-start gap-5 md:grid-cols-[300px_minmax(0,1fr)]">
          <h2 class="builders-impact-heading text-[26px] font-bold leading-[1.08] tracking-[-0.04em] text-[var(--marketing-text)] md:col-span-2 md:text-[28px]">Where Skilly drives impact</h2>

          <div class="space-y-2.5">
              <article class="relative rounded-[18px] border border-[var(--marketing-accent-border)] bg-white px-4 py-3.5 shadow-[var(--marketing-shadow-card)]">
                <div class="flex items-start gap-3.5">
                  <div class="grid h-10 w-10 place-items-center rounded-full border border-[#E7DDCF] bg-[#FFFBF3] text-[#221E19]">
                    <Rocket size={19} strokeWidth={1.8} aria-hidden="true" />
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="flex items-start justify-between gap-3">
                      <h3 class="text-[16px] font-semibold text-[var(--marketing-text)]">New user activation</h3>
                      <Badge
                        variant="featured"
                        size="xs"
                        uppercase={false}
                        class="shrink-0 uppercase tracking-[0.04em]"
                      >
                        Most common
                      </Badge>
                    </div>
                    <div class="mt-1 flex items-start justify-between gap-3">
                      <p class="min-w-0 text-[13px] leading-[1.4] text-[var(--marketing-muted)]">Guide new users to their first “aha” moment.</p>
                      <ChevronRight size={18} strokeWidth={1.8} class="impact-featured-chevron mt-0.5 shrink-0 text-[#312C27]" aria-hidden="true" />
                    </div>
                  </div>
                </div>
              </article>

              <article class="rounded-[18px] border border-[var(--marketing-surface-border)] bg-white px-4 py-3.5 shadow-[var(--marketing-shadow-card)]">
                <div class="flex items-start gap-3.5">
                  <div class="grid h-10 w-10 place-items-center rounded-full border border-[var(--marketing-border)] bg-[var(--marketing-section)] text-[#221E19]">
                    <ChartNoAxesColumn size={19} strokeWidth={1.8} aria-hidden="true" />
                  </div>
                  <div class="min-w-0 flex-1">
                    <h3 class="text-[16px] font-semibold text-[var(--marketing-text)]">Feature adoption</h3>
