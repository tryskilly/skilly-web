---
// src/pages/learn/[...slug].astro
// Dynamic route — renders every markdown article in the learn collection.
// Articles with CTA markers split so the buttons are in the static HTML:
// <!-- skilly-top-cta --> after the opening answer, <!-- skilly-mid-cta -->
// after the step where the reader is stuck.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { getCollection, render } from 'astro:content';
import LearnLayout from '../../layouts/LearnLayout.astro';
import LearnMidArticleCta from '../../components/LearnMidArticleCta.astro';

export async function getStaticPaths() {
  const entries = await getCollection('learn');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const articleSlug = entry.id.replace(/\.md$/, '');
const midCta = entry.data.midCta;
const TOP_MARKER = '<!-- skilly-top-cta -->';
const MID_MARKER = '<!-- skilly-mid-cta -->';

type Segment =
  | { kind: 'html'; html: string }
  | { kind: 'top' }
  | { kind: 'mid' };

let segments: Segment[] | null = null;

const raw = readFileSync(join(process.cwd(), 'src/content/learn', `${articleSlug}.md`), 'utf8');
const body = raw.replace(/^---[\s\S]*?---\n?/, '');
const topCount = body.split(TOP_MARKER).length - 1;
const midCount = body.split(MID_MARKER).length - 1;

if (topCount > 1) {
  throw new Error(`${articleSlug} has ${topCount} ${TOP_MARKER} markers`);
}
if (midCount > 1) {
  throw new Error(`${articleSlug} has ${midCount} ${MID_MARKER} markers`);
}
if (midCta && midCount !== 1) {
  throw new Error(`${articleSlug} sets midCta but has no ${MID_MARKER} marker`);
}
if (!midCta && midCount > 0) {
  throw new Error(`${articleSlug} has ${MID_MARKER} but no midCta frontmatter`);
}

if (topCount > 0 || midCount > 0) {
  const processor = await createMarkdownProcessor();
  const parts = body.split(/<!-- skilly-(top|mid)-cta -->/);
  segments = [];
  for (let index = 0; index < parts.length; index += 1) {
    const part = parts[index] ?? '';
    if (index % 2 === 0) {
      if (!part.trim()) continue;
      segments.push({ kind: 'html', html: (await processor.render(part)).code });
    } else if (part === 'top') {
      segments.push({ kind: 'top' });
    } else {
      segments.push({ kind: 'mid' });
    }
  }
}

const { Content } = await render(entry);
---
<LearnLayout entry={entry}>
  {segments ? (
    segments.map((segment) => (
      segment.kind === 'html' ? (
        <div class="contents" set:html={segment.html} />
      ) : segment.kind === 'top' ? (
        <LearnMidArticleCta placement="top" articleSlug={articleSlug} />
      ) : (
        <LearnMidArticleCta
          moment={midCta!.moment}
          landerHref={midCta!.landerHref}
          landerLabel={midCta!.landerLabel}
          articleSlug={articleSlug}
        />
      )
    ))
  ) : (
    <Content />
  )}
</LearnLayout>
