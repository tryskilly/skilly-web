  <script is:inline define:vars={{ DEFAULT_DEMO_GOAL }}>
    const launchDemo = (goal) => {
      const skilly = window.Skilly;
      if (skilly?.start) {
        skilly.start(goal);
      } else {
        window.dispatchEvent(new CustomEvent('skilly:demo-requested', { detail: { goal } }));
      }
    };

    document.querySelectorAll('[data-builders-widget-demo]').forEach((button) => {
      button.addEventListener('click', () => launchDemo(DEFAULT_DEMO_GOAL));
    });
  </script>

