---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import BuildersSection from '../components/Builders.astro';
import Footer from '../components/Footer.astro';
import SkillyWebWidget from '../components/SkillyWebWidget.astro';

const STUDIO_URL = 'https://studio.tryskilly.app/signup';
---
<Layout
  title="Skilly for Builders - Voice guidance for your website"
  description="Skilly for Builders lets website and app owners install a voice-and-pointer guide that answers from site content, docs, and project skills managed in Studio."
  productLine="builders"
  funnelStage="conversion"
>
  <Nav />
  <main class="overflow-x-clip pt-16">
    <section class="relative px-6 pt-24 pb-16 lg:pt-32 lg:pb-20 bg-[#FAFAF8] overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute top-12 right-0 h-[520px] w-[520px] rounded-full" style="background: radial-gradient(circle, rgba(245,158,11,0.18), transparent 68%);"></div>
      <div class="relative max-w-site mx-auto grid gap-10 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:items-center">
        <div>
          <span class="text-[13px] font-semibold text-amber-600 tracking-[1.5px] uppercase">Skilly for builders</span>
          <h1 class="mt-4 text-4xl sm:text-5xl lg:text-[64px] font-bold leading-[1.06] tracking-tight text-gray-900">
            Give your website a guide that speaks and points.
          </h1>
          <p class="mt-6 max-w-[620px] text-lg lg:text-xl leading-relaxed text-gray-600">
            Customers should not have to search docs, watch onboarding videos, or open support just to find the next step. Skilly answers on the page, out loud, using the website skill you control in Studio.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href={STUDIO_URL} data-ph-event="web_builders_studio_clicked" data-ph-prop-location="builders_hero" data-ph-prop-target-funnel="builders" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 active:scale-[0.98] text-gray-950 shadow-md hover:shadow-lg rounded-lg px-7 py-3.5 text-[16px] font-semibold transition-all whitespace-nowrap">
              Create a Studio project
            </a>
            <a href="/#builders" data-ph-event="web_builders_overview_clicked" data-ph-prop-location="builders_hero" data-ph-prop-target-funnel="builders" class="inline-flex items-center justify-center border border-gray-300 hover:border-gray-400 bg-white hover:bg-gray-50 active:scale-[0.98] text-gray-800 rounded-lg px-7 py-3.5 text-[16px] font-semibold transition-all whitespace-nowrap">
              See how it works
            </a>
          </div>
        </div>
        <div class="rounded-[28px] border border-gray-200 bg-white p-6 shadow-xl">
          <div class="grid gap-4">
            <div class="rounded-2xl border border-gray-200 bg-gray-50 p-5">
              <div class="text-sm font-semibold text-amber-700">Studio project</div>
              <div class="mt-2 text-2xl font-bold text-gray-900">Customer onboarding guide</div>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">One project owns the website skill, domains, widget style, install snippet, and usage.</p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="rounded-2xl border border-gray-200 p-5">
                <div class="text-3xl font-bold text-gray-900">1</div>
                <p class="mt-2 text-sm text-gray-600">Import a site URL and docs.</p>
              </div>
              <div class="rounded-2xl border border-gray-200 p-5">
                <div class="text-3xl font-bold text-gray-900">2</div>
                <p class="mt-2 text-sm text-gray-600">Preview the guide before install.</p>
              </div>
              <div class="rounded-2xl border border-gray-200 p-5">
                <div class="text-3xl font-bold text-gray-900">3</div>
                <p class="mt-2 text-sm text-gray-600">Lock it to allowed domains.</p>
              </div>
              <div class="rounded-2xl border border-gray-200 p-5">
                <div class="text-3xl font-bold text-gray-900">4</div>
                <p class="mt-2 text-sm text-gray-600">Install the CDN snippet.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <BuildersSection />
    <section class="px-6 py-20 bg-white border-y border-gray-200">
      <div class="max-w-site mx-auto grid gap-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center">
        <div>
          <span class="text-[13px] font-semibold text-amber-600 tracking-[1.5px] uppercase">Studio pricing</span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">A different package from the Mac app.</h2>
          <p class="mt-4 text-[17px] leading-relaxed text-gray-600">The Mac app is sold as hosted tutoring minutes for one user. Skilly for Builders is organized around Studio projects: one website skill, allowed domains, widget setup, and usage analytics per surface.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          <div class="rounded-2xl border border-gray-200 bg-gray-50 p-5">
            <div class="text-sm font-semibold text-gray-900">Project</div>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">One website or app surface with its own skill.</p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-gray-50 p-5">
            <div class="text-sm font-semibold text-gray-900">Usage</div>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">Tracked per project so teams see cost, adoption, and errors.</p>
          </div>
          <div class="rounded-2xl border border-gray-200 bg-gray-50 p-5">
            <div class="text-sm font-semibold text-gray-900">Beta</div>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">Start in Studio first; public packaging can evolve from real usage.</p>
          </div>
        </div>
      </div>
    </section>
    <section class="px-6 py-20 bg-gray-50 border-y border-gray-200">
      <div class="max-w-[760px] mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">Built for product guidance, not generic chat.</h2>
        <p class="mt-4 text-[17px] leading-relaxed text-gray-600">Skilly should know your product, stay inside allowed surfaces, and help users complete real tasks with voice and pointing.</p>
        <a href={STUDIO_URL} data-ph-event="web_builders_studio_clicked" data-ph-prop-location="builders_bottom" data-ph-prop-target-funnel="builders" class="mt-8 inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 active:scale-[0.98] text-gray-950 shadow-md hover:shadow-lg rounded-lg px-8 py-3.5 text-[16px] font-semibold transition-all whitespace-nowrap">
          Create your first project
        </a>
      </div>
    </section>
  </main>
  <Footer />
  <SkillyWebWidget />
</Layout>
