---
// Homepage "Try asking..." block. Questions come from the bundled skills
// (see src/data/askExamples.ts) and link to the matching /learn/ guide.
import { askApps } from '../data/askExamples.ts';

function learnSlug(href: string): string {
  return href.replace(/^\/learn\//, '').replace(/\/$/, '');
}
---
<section id="try-asking" class="mx-auto max-w-[1360px] px-5 pb-10 sm:px-8" aria-labelledby="try-asking-heading">
  <div class="text-center">
    <h2 id="try-asking-heading" class="text-[40px] font-bold leading-none tracking-[-0.04em] text-[#2a2421] sm:text-[42px]">
      Try asking...
    </h2>
    <p class="mx-auto mt-4 max-w-[640px] text-[15px] leading-[1.65] text-[#5f534d]">
      Say it the way you would to someone sitting next to you. Skilly hears the question and points at the control.
      It never clicks, and it never moves your cursor.
    </p>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {askApps.map((app) => (
      <article class="flex flex-col rounded-[22px] border border-[#f2e6df] bg-white px-5 py-5 shadow-[0_12px_26px_rgba(111,73,48,0.04)]">
        <h3 class="text-[18px] font-semibold text-[#2a2421]">
          <a
            href={`/${app.slug}/`}
            data-ph-event="web_learn_related_clicked"
            data-ph-prop-location="home_ask_examples"
            data-ph-prop-target-article={app.slug}
            class="underline decoration-[#f0c3ad] underline-offset-4 hover:text-[#c2410c] hover:decoration-[#c2410c]"
          >
            {app.name}
          </a>
        </h3>
        <ul class="mt-3 flex flex-col gap-2.5">
          {app.questions.slice(0, 3).map((example) => (
            <li>
              <a
                href={example.learnHref}
                data-ph-event="web_learn_related_clicked"
                data-ph-prop-location="home_ask_examples"
                data-ph-prop-target-article={learnSlug(example.learnHref)}
                class="block rounded-xl bg-[#fff8f4] px-3.5 py-3 text-[14.5px] leading-[1.45] text-[#43352f] transition hover:bg-[#fff1e8] hover:text-[#9a3412]"
              >
                “{example.question}”
              </a>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</section>
