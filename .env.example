# Resend (https://resend.com) — used by the waitlist API endpoint.
# Get your key at: https://resend.com/api-keys
# The key needs "Full access" so it can manage audiences as well as send emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Resend audience ID for the Skilly waitlist.
# Create one at: https://resend.com/audiences
RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Optional Resend segment for contacts who explicitly opt into marketing from
# the Skill Builder. Lead contact records are stored regardless of opt-in;
# subscription is changed only when the checkbox is selected.
RESEND_MARKETING_SEGMENT_ID=00000000-0000-0000-0000-000000000000

# Resend audience ID for skill request submissions.
RESEND_SKILL_REQUESTS_AUDIENCE_ID=00000000-0000-0000-0000-000000000000

# Optional: GA4 Measurement ID override for web analytics.
# If unset, the default ID in src/layouts/Layout.astro is used.
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: enables the AI onboarding audit to use OpenAI for crawler-backed
# scoring and guide generation. Without this key, the tool falls back to the
# local deterministic rubric.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_AUDIT_MODEL=gpt-5.4-mini
# Optional model override for the B2C Skill Builder. Falls back to
# OPENAI_AUDIT_MODEL, then the server's conservative default.
OPENAI_SKILL_BUILDER_MODEL=gpt-5.4-mini

# Optional durable cache for generated skills (Upstash-compatible REST API).
# Without these values, a bounded in-memory cache is still used per instance.
SKILL_BUILDER_CACHE_REST_URL=https://example.upstash.io
SKILL_BUILDER_CACHE_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx


# Optional Skilly Web dogfood widget overrides.
# Defaults in src/components/SkillyWebWidget.astro point to the production beta tenant.
PUBLIC_SKILLY_WEB_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_SKILLY_WEB_SKILL=skilly-marketing
PUBLIC_SKILLY_WEB_BACKEND_URL=https://studio.tryskilly.app
PUBLIC_SKILLY_WEB_CDN_URL=https://cdn.tryskilly.app/web/v1.js
PUBLIC_SKILLY_WEB_CORE_URL=https://cdn.tryskilly.app/web/v1.0.0/skilly_core_web_sdk.js
