---
// src/components/Nav.astro
import Logo from './Logo.astro';
import Wordmark from './Wordmark.astro';
import { DOWNLOAD_URL } from '../data/config.ts';

// Builders is the homepage, so treat "/" as a builders surface.
const isBuildersPage = Astro.url.pathname === '/' || Astro.url.pathname.startsWith('/builders');
const isAudiencePage = Astro.url.pathname.startsWith('/people') || isBuildersPage;
const pricingHref = isAudiencePage ? '#pricing' : '/#pricing';
const faqHref = isAudiencePage ? '#faq' : '/#faq';
const primaryHref = isBuildersPage ? 'https://studio.tryskilly.app/signup' : DOWNLOAD_URL;
const primaryLabel = isBuildersPage ? 'Open Studio' : 'Download';
const primaryEvent = isBuildersPage ? 'web_builders_studio_clicked' : 'web_cta_download_clicked';
const primaryTargetFunnel = isBuildersPage ? 'builders' : undefined;
---
<header
  data-nav
  class="fixed top-0 left-0 right-0 z-50 nav-blur border-b border-transparent transition-all duration-300"
>
  <div class="max-w-site mx-auto px-6 h-16 flex items-center justify-between">
    <a href="#top" class="flex items-center gap-2.5">
      <Logo size={26} variant="amber" alt="Skilly" />
      <Wordmark size="md" />
    </a>

    <nav class="hidden md:flex items-center gap-7">
      <a href="/people" data-ph-event="web_nav_link_clicked" data-ph-prop-link="people" class="text-gray-600 hover:text-gray-900 text-[15px] font-medium transition-colors">For People</a>
      <a href="/" data-ph-event="web_nav_link_clicked" data-ph-prop-link="builders" class="text-gray-600 hover:text-gray-900 text-[15px] font-medium transition-colors">For Builders</a>
      <a href={pricingHref} data-ph-event="web_nav_link_clicked" data-ph-prop-link="pricing" class="text-gray-600 hover:text-gray-900 text-[15px] font-medium transition-colors">Pricing</a>
      <a href={faqHref} data-ph-event="web_nav_link_clicked" data-ph-prop-link="faq" class="text-gray-600 hover:text-gray-900 text-[15px] font-medium transition-colors">FAQ</a>
      <a href="/learn" data-ph-event="web_nav_link_clicked" data-ph-prop-link="learn" class="text-gray-600 hover:text-gray-900 text-[15px] font-medium transition-colors">Learn</a>
      <a
        href={primaryHref}
        data-ph-event={primaryEvent}
        data-ph-prop-location="nav"
        data-ph-prop-target-funnel={primaryTargetFunnel}
        class="inline-flex items-center gap-1.5 bg-amber-500 hover:bg-amber-600 text-gray-950 shadow-sm hover:shadow-md rounded-md px-5 py-2 text-sm font-semibold transition-all"
      >
        {primaryLabel}
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 12L12 4M12 4H5M12 4V11"/>
        </svg>
      </a>
    </nav>

    <a
      href={primaryHref}
      data-ph-event={primaryEvent}
      data-ph-prop-location="nav_mobile"
      data-ph-prop-target-funnel={primaryTargetFunnel}
      class="md:hidden inline-flex items-center gap-1.5 bg-amber-500 hover:bg-amber-600 text-gray-950 shadow-sm rounded-md px-4 py-2 text-sm font-semibold"
    >
      {primaryLabel}
    </a>
  </div>
</header>

<script>
  import '../scripts/nav-scroll.ts';
</script>
