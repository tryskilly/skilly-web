---
// Click-to-load facade for the vertical demo. No image and no iframe until
// the visitor presses play, so this cannot become the LCP element.
---
<div class="hero-short" data-hero-short>
  <button type="button" data-hero-short-play aria-label="Play the 30-second Skilly demo">
    <span class="hero-short-mark" aria-hidden="true"></span>
    <span class="hero-short-label">30-second demo</span>
  </button>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-hero-short]');
    if (!root) return;
    var button = root.querySelector('[data-hero-short-play]');
    if (!button) return;
    button.addEventListener('click', function () {
      var iframe = document.createElement('iframe');
      iframe.src = 'https://www.youtube-nocookie.com/embed/Bs4PAOwHotE?autoplay=1&rel=0&modestbranding=1&playsinline=1';
      iframe.title = 'Skilly 30-second demo';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.setAttribute('allowfullscreen', '');
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.loading = 'lazy';
      root.replaceChildren(iframe);
    });
  })();
</script>

<style is:global>
  .hero-short {
    width: min(200px, 62vw);
    aspect-ratio: 9 / 16;
    overflow: hidden;
    border-radius: 18px;
    background: #211c1a;
    box-shadow: 0 16px 36px rgba(67, 36, 23, 0.16);
  }
  .hero-short iframe,
  .hero-short button {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .hero-short button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: #fff;
    background:
      radial-gradient(circle at 50% 40%, rgba(255, 111, 63, 0.42), transparent 48%),
      #211c1a;
    cursor: pointer;
  }
  .hero-short-mark {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: #fff;
    position: relative;
  }
  .hero-short-mark::after {
    content: '';
    position: absolute;
    top: 14px;
    left: 18px;
    border-style: solid;
    border-width: 8px 0 8px 13px;
    border-color: transparent transparent transparent #211c1a;
  }
  .hero-short-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  @media (max-width: 767px) {
    .hero-short {
      width: min(168px, 48vw);
    }
  }
</style>
