---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Button from './Button.astro';
import ComparisonTable from './ComparisonTable.astro';
import { buildersComparisonIndexItems, type BuildersComparisonPage } from '../data/buildersComparisonPages.ts';

interface Props {
  page: BuildersComparisonPage;
}

const { page } = Astro.props;
const ctaUrl = 'https://studio.tryskilly.app/signup';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: page.title,
  description: page.description,
  url: `https://tryskilly.app/vs/${page.slug}`,
  about: [
    { '@type': 'SoftwareApplication', name: 'Skilly for Builders', applicationCategory: 'BusinessApplication', operatingSystem: 'Web (embeddable)' },
    { '@type': 'SoftwareApplication', name: page.competitor, applicationCategory: 'BusinessApplication', operatingSystem: 'Web' },
  ],
  mainEntity: page.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
const related = buildersComparisonIndexItems.filter((item) => item.href !== `/vs/${page.slug}`).slice(0, 4);
const comparisonColumns = [
  { key: 'skilly', label: 'Skilly', isSkilly: true },
  { key: 'competitor', label: page.competitor },
];
---
<Layout title={page.title} description={page.description} productLine="builders" funnelStage="consideration">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </Fragment>
  <Nav />

  <div class="sr-only">
    <h2>Skilly vs {page.competitor}: short answer</h2>
    <p>{page.quickTake} Pick Skilly if {page.pickSkilly} Pick {page.competitor} if {page.pickCompetitor}</p>
    <h2>Target queries</h2>
    <p>{page.targetQueries.join(', ')}</p>
  </div>

  <main class="marketing-page overflow-x-clip">
    <section class="marketing-hero relative max-w-site mx-auto px-6">
      <div class="max-w-[840px] mx-auto text-center">
        <p class="marketing-eyebrow mb-4">Honest comparison</p>
        <h1 class="marketing-title text-4xl sm:text-5xl lg:text-[56px] font-bold leading-[1.1] tracking-tight mb-6">
          Skilly <span class="text-gray-400">vs</span> {page.competitor}
        </h1>
        <p class="marketing-copy text-lg lg:text-xl leading-relaxed mb-8 max-w-[700px] mx-auto">
          {page.quickTake}
        </p>
      </div>
    </section>

    <section class="max-w-site mx-auto px-6 pb-12">
      <div class="max-w-[960px] mx-auto grid md:grid-cols-2 gap-5">
        <div class="marketing-card p-7">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-500"></span>
            <span class="marketing-section-heading font-semibold">Pick Skilly if</span>
          </div>
          <p class="marketing-copy leading-relaxed text-[15px]">{page.pickSkilly}</p>
        </div>
        <div class="marketing-card p-7">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-gray-400"></span>
            <span class="marketing-section-heading font-semibold">Pick {page.competitor} if</span>
          </div>
          <p class="marketing-copy leading-relaxed text-[15px]">{page.pickCompetitor}</p>
        </div>
      </div>
    </section>

    <section class="max-w-site mx-auto px-6 pb-16">
      <div class="max-w-[960px] mx-auto grid lg:grid-cols-[0.9fr_1.1fr] gap-6 items-start">
        <div class="marketing-card marketing-card--accent p-7">
          <p class="marketing-eyebrow mb-3">Best read</p>
          <h2 class="marketing-section-heading text-2xl font-semibold mb-3">Different jobs, different tools</h2>
          <p class="marketing-copy leading-relaxed mb-5">{page.skillySummary}</p>
          <p class="marketing-copy leading-relaxed">{page.competitorSummary}</p>
        </div>
        <ComparisonTable columns={comparisonColumns} rows={page.rows} />
      </div>
      <p class="text-xs text-gray-400 mt-3 text-center">{page.sourceNote}</p>
    </section>

    <section class="max-w-site mx-auto px-6 pb-16">
      <div class="max-w-[760px] mx-auto" itemscope itemtype="https://schema.org/FAQPage">
        <h2 class="marketing-section-heading text-2xl lg:text-3xl font-semibold mb-8 text-center">Common questions</h2>
        <div class="space-y-5">
          {page.faqs.map((faq) => (
            <div class="marketing-card p-6" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <h3 class="text-lg font-semibold text-gray-900 mb-2" itemprop="name">{faq.question}</h3>
              <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <p class="text-gray-700 leading-relaxed text-[15px]" itemprop="text">{faq.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="max-w-site mx-auto px-6 pb-16">
      <div class="marketing-cta max-w-[680px] mx-auto text-center p-10">
        <h2 class="marketing-section-heading text-2xl lg:text-3xl font-semibold mb-3">Add a voice guide to your product</h2>
        <p class="text-gray-600 mb-6">One script tag. Free founding tier, then $29/month. Voice-first, no sales call.</p>
        <Button
          href={ctaUrl}
          variant="builders-accent"
          size="xl"
          data-ph-event="web_cta_builders_signup_clicked"
          data-ph-prop-location={`vs_${page.slug.replaceAll('-', '_')}`}
          data-ph-prop-campaign={`vs-${page.slug}`}
          data-ph-prop-target-funnel="builders"
          rel="nofollow"
          class="shadow-md hover:shadow-lg"
        >
          Start free in Studio
        </Button>
      </div>
    </section>

    <section class="max-w-site mx-auto px-6 pb-20">
      <div class="max-w-[960px] mx-auto">
        <h2 class="marketing-section-heading text-xl font-semibold mb-4">More onboarding-tool comparisons</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {related.map((item) => (
            <a href={item.href} class="marketing-link-card block px-5 py-4">
              <p class="font-medium text-gray-900">{item.name}</p>
              <p class="text-sm text-gray-500 mt-1">{item.summary}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
