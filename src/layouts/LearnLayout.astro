---
// src/layouts/LearnLayout.astro
// Wraps base Layout.astro and injects per-article Article + optional HowTo +
// optional FAQPage + Dataset + BreadcrumbList + Person schema. Used by every
// /learn/* page.
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import NonMacWaitlist from '../components/NonMacWaitlist.astro';
import { DOWNLOAD_URL } from '../data/config.ts';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'learn'>;
}

const { entry } = Astro.props;
const { data, slug } = entry as any;
const articleSlug = slug ?? entry.id.replace(/\.md$/, '');

const siteUrl = 'https://tryskilly.app';
const articleUrl = `${siteUrl}/learn/${articleSlug}/`;
const ogImage = data.ogImage ?? data.heroImage ?? '/og-image.png';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: data.author,
  url: 'https://x.com/moelabs_dev',
  sameAs: [
    'https://x.com/moelabs_dev',
    'https://github.com/eng-mohamedszaied',
  ],
  jobTitle: 'Founder, Skilly',
  worksFor: {
    '@type': 'Organization',
    name: 'Skilly',
    url: siteUrl,
  },
};

const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: data.author,
    url: 'https://x.com/moelabs_dev',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Skilly',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/skilly-mark.png`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  url: articleUrl,
  image: new URL(ogImage, siteUrl).toString(),
  keywords: data.tags.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Learn', item: `${siteUrl}/learn/` },
    { '@type': 'ListItem', position: 3, name: data.title, item: articleUrl },
  ],
};

const howToSchema = data.howTo
  ? {
      '@context': 'https://schema.org',
      '@type': 'HowTo',
      name: data.title,
      description: data.description,
      ...(data.howTo.totalTime && { totalTime: data.howTo.totalTime }),
      ...(data.howTo.tools && {
        tool: data.howTo.tools.map((name: string) => ({ '@type': 'HowToTool', name })),
      }),
      ...(data.howTo.supplies && {
        supply: data.howTo.supplies.map((name: string) => ({ '@type': 'HowToSupply', name })),
      }),
      step: data.howTo.steps.map((step: any, i: number) => ({
        '@type': 'HowToStep',
        position: i + 1,
        name: step.name,
        text: step.text,
        ...(step.image && { image: step.image }),
      })),
    }
  : null;

const faqSchema = data.faq && data.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: data.faq.map((q: { question: string; answer: string }) => ({
        '@type': 'Question',
        name: q.question,
        acceptedAnswer: { '@type': 'Answer', text: q.answer },
      })),
    }
  : null;

const datasetSchema = data.dataset
  ? {
      '@context': 'https://schema.org',
      '@type': 'Dataset',
      name: data.dataset.name,
      description: data.dataset.description,
      url: articleUrl,
      creator: {
        '@type': 'Organization',
        name: 'Skilly',
        url: siteUrl,
      },
      publisher: {
        '@type': 'Organization',
        name: 'Skilly',
        url: siteUrl,
      },
      datePublished: data.pubDate.toISOString(),
      dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
      version: data.dataset.version,
      license: data.dataset.license,
      isAccessibleForFree: true,
      keywords: data.tags.join(', '),
      variableMeasured: data.dataset.variableMeasured,
      isBasedOn: data.dataset.isBasedOn,
      distribution: {
        '@type': 'DataDownload',
        contentUrl: new URL(data.dataset.distributionUrl, siteUrl).toString(),
        encodingFormat: data.dataset.encodingFormat,
      },
    }
  : null;

const formattedDate = data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const formattedUpdatedDate = data.updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categoryLabels: Record<string, string> = {
  tutorial: 'Tutorial',
  'how-to': 'How-to',
  comparison: 'Comparison',
  concept: 'Concept',
  troubleshooting: 'Troubleshooting',
};

const appLabels: Record<string, string> = {
  xcode: 'Xcode',
  swiftui: 'Xcode',
  blender: 'Blender',
  figma: 'Figma',
  houdini: 'Houdini',
  'after-effects': 'After Effects',
  'davinci-resolve': 'DaVinci Resolve',
  'premiere-pro': 'Premiere Pro',
};
const articleTags = data.tags ?? [];
const articleApp = articleTags.map((tag: string) => appLabels[tag]).find(Boolean);
const buildersIntentTags = new Set([
  'builders',
  'mcp',
  'realtime-api',
  'user onboarding',
  'product tours',
  'ai onboarding agent',
  'in-app guidance',
]);
const targetsBuilders = articleTags.some((tag: string) => buildersIntentTags.has(tag));
const ctaHeadline = targetsBuilders
  ? 'Turn your product knowledge into live guidance.'
  : articleApp
    ? `Still stuck in ${articleApp}? Ask your screen.`
    : 'Get live help without leaving the app.';
const ctaDescription = targetsBuilders
  ? 'Import your site and docs, preview a voice-first guide, and install it with one script tag.'
  : articleApp
    ? `Skilly sees your ${articleApp} window, hears your question, and points at the exact control to use. Try it for 15 minutes free — no card.`
    : 'Skilly sees the Mac app you are using, hears your question, and points at the exact control to use. Try it for 15 minutes free — no card.';
const ctaEyebrow = targetsBuilders ? 'Build on what you just learned' : 'Try it on what you are learning';
const studioCtaUrl = new URL('https://studio.tryskilly.app/signup');
studioCtaUrl.searchParams.set('utm_source', 'tryskilly-web');
studioCtaUrl.searchParams.set('utm_medium', 'referral');
studioCtaUrl.searchParams.set('utm_campaign', 'learn-to-studio');
studioCtaUrl.searchParams.set('utm_content', articleSlug);
// People-funnel CTAs go through /download, which reads utm_* params into its
// download_served event. Campaign = placement, content = article slug.
const learnDownloadUrl = (placement: string) => {
  const params = new URLSearchParams({
    utm_source: 'tryskilly-web',
    utm_medium: 'learn',
    utm_campaign: placement,
    utm_content: articleSlug,
  });
  return `${DOWNLOAD_URL}?${params.toString()}`;
};
const ctaHrefFor = (placement: string) =>
  targetsBuilders ? studioCtaUrl.toString() : learnDownloadUrl(placement);
const ctaEvent = targetsBuilders ? 'web_builders_studio_clicked' : 'web_cta_download_clicked';
const ctaTargetFunnel = targetsBuilders ? 'builders' : 'people';
const ctaText = targetsBuilders ? 'Start free in Studio' : 'Download for Mac';
// Backed by the 15-minute, no-card trial stated in tiers.ts and the FAQ.
// Download CTAs carry data-mac-download so Windows/Linux/mobile visitors get
// the waitlist instead (see NonMacWaitlist.astro). Studio CTAs work anywhere.
const macOnly = targetsBuilders ? {} : { 'data-mac-download': '' };
const ctaSubline = targetsBuilders ? null : '15-minute free trial, no card';
const secondaryHref = targetsBuilders ? '/builders/' : '/';
const secondaryText = targetsBuilders ? 'See Skilly for Builders' : 'See how it works';
// Readers arrive mid-task from search and rarely reach the end-of-article CTA
// (433 Learn visitors → 1 download in 90 days), so the same offer also appears
// right under the header and as a sticky bar once they are reading.
const earlyCtaText = targetsBuilders
  ? 'Building onboarding for your own product? Skilly drafts a voice guide from your docs.'
  : `Doing this in ${articleApp ?? 'a Mac app'} right now? Skilly sees your screen and points at the exact button.`;
const stickyCtaShortText = targetsBuilders
  ? 'Guide your own users with Skilly.'
  : `Stuck in ${articleApp ?? 'an app'}? Skilly points at the button.`;
const privacyNote = targetsBuilders
  ? 'Start free. Import public content first; add private sources only when you are ready.'
  : 'Push-to-talk only. Nothing from your screen is saved after the session.';

const allLearnEntries = await getCollection('learn');
const explicitRelated = new Set(data.relatedArticles ?? []);
const currentTags = new Set<string>(data.tags ?? []);
const relatedArticles = allLearnEntries
  .filter((candidate) => {
    const candidateSlug = candidate.id.replace(/\.md$/, '');
    return candidateSlug !== articleSlug;
  })
  .map((candidate) => {
    const candidateData = candidate.data as any;
    const candidateSlug = candidate.id.replace(/\.md$/, '');
    const sharedTagCount = (candidateData.tags ?? []).filter((tag: string) => currentTags.has(tag)).length;
    const sameSeries = Boolean(data.series && candidateData.series === data.series);
    const lessonDistance =
      sameSeries && data.lessonNumber && candidateData.lessonNumber
        ? Math.abs(data.lessonNumber - candidateData.lessonNumber)
        : Number.MAX_SAFE_INTEGER;

    return {
      entry: candidate,
      slug: candidateSlug,
      score: explicitRelated.has(candidateSlug) ? 1000 : (sameSeries ? 100 : 0) + sharedTagCount * 10,
      lessonDistance,
    };
  })
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score || a.lessonDistance - b.lessonDistance || a.slug.localeCompare(b.slug))
  .slice(0, 4);
---
<Layout
  title={data.title}
  description={data.description}
  ogImage={ogImage}
  productLine="learn"
  funnelStage="education"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
    {howToSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />
    )}
    {faqSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    )}
    {datasetSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(datasetSchema)} />
    )}
  </Fragment>

  <Nav variant={ctaTargetFunnel} />

  <main class="overflow-x-clip">
    <article
      class="max-w-site mx-auto px-6 pt-32 lg:pt-40 pb-16"
      data-learn-article
      data-article-slug={articleSlug}
      data-article-category={data.category}
    >
      <div class="max-w-[760px] mx-auto">
        <nav class="text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 flex-wrap">
            <li><a href="/" class="hover:text-amber-700 transition-colors">Home</a></li>
            <li aria-hidden="true" class="text-gray-300">/</li>
            <li><a href="/learn/" class="hover:text-amber-700 transition-colors">Learn</a></li>
            <li aria-hidden="true" class="text-gray-300">/</li>
            <li class="text-gray-700 truncate max-w-[280px] sm:max-w-md">{data.title}</li>
          </ol>
        </nav>

        <header class="mb-12">
          <p class="text-[11px] font-mono tracking-[0.08em] uppercase text-amber-700 mb-4">
            {categoryLabels[data.category] ?? data.category}
          </p>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-gray-900 leading-[1.15]">
            {data.title}
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-gray-600">{data.description}</p>
          <div class="mt-7 flex items-center gap-3 text-[13px] text-gray-500">
            <span>By <span class="text-gray-700 font-medium">{data.author}</span></span>
            <span aria-hidden="true" class="text-gray-300">•</span>
            <time datetime={data.pubDate.toISOString()}>Published {formattedDate}</time>
            {formattedUpdatedDate && (
              <>
                <span aria-hidden="true" class="text-gray-300">•</span>
                <time datetime={data.updatedDate.toISOString()}>Updated {formattedUpdatedDate}</time>
              </>
            )}
            {data.howTo?.totalTime && (
              <>
                <span aria-hidden="true" class="text-gray-300">•</span>
                <span>~{data.howTo.totalTime.replace('PT', '').replace('M', ' min').replace('H', ' hr ').trim()}</span>
              </>
            )}
          </div>
        </header>

        <aside data-learn-early-cta class="mb-10 flex flex-col gap-4 rounded-xl border border-amber-200/70 bg-amber-50/70 px-5 py-5 sm:flex-row sm:items-center sm:justify-between">
          <p {...macOnly} class="text-[15px] leading-snug text-gray-800 sm:max-w-[420px]">{earlyCtaText}</p>
          {!targetsBuilders && <NonMacWaitlist id="learn-waitlist" location="learn_inline" />}
          <div {...macOnly} class="flex shrink-0 flex-col items-start gap-1.5 sm:items-center">
            <a
              href={ctaHrefFor('learn_inline')}
              rel={targetsBuilders ? 'nofollow' : undefined}
              data-ph-event={ctaEvent}
              data-ph-prop-location="learn_inline"
              data-ph-prop-cta-variant="early_inline"
              data-ph-prop-target-funnel={ctaTargetFunnel}
              data-ph-prop-article-slug={articleSlug}
              data-ph-prop-article-category={data.category}
              data-ph-prop-cta-text={ctaText}
              class="inline-flex items-center justify-center gap-1.5 rounded-md bg-amber-500 px-5 py-2.5 text-[15px] font-semibold text-gray-950 shadow-sm transition-all hover:bg-amber-600 hover:shadow-md"
            >
              {ctaText}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 3v9M4 8l4 4 4-4"/>
              </svg>
            </a>
            {ctaSubline && <span class="text-[12px] text-gray-600">{ctaSubline}</span>}
          </div>
        </aside>

        <div class="prose prose-skilly max-w-none" data-learn-prose>
          <slot />
        </div>
        <script is:inline>
          (function () {
            var cta = document.querySelector('[data-learn-early-cta]');
            var intro = document.querySelector('[data-learn-prose] > p');
            if (cta && intro) {
              cta.classList.remove('mb-10');
              cta.classList.add('not-prose', 'my-8');
              intro.after(cta);
            }
          })();
        </script>

        <aside data-learn-cta class="mt-12 p-8 lg:p-10 rounded-2xl bg-gradient-to-br from-amber-50 to-amber-100/40 border border-amber-200/60">
          <p class="text-[11px] font-mono tracking-[0.08em] uppercase text-amber-700 mb-3">{ctaEyebrow}</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3 tracking-tight">
            {ctaHeadline}
          </h2>
          <p class="text-[15px] text-gray-700 leading-relaxed mb-2 max-w-[580px]">
            {ctaDescription}
          </p>
          <p class="text-[13px] text-gray-600 leading-relaxed mb-6 max-w-[580px]">
            {privacyNote}
          </p>
          {!targetsBuilders && <NonMacWaitlist location="learn_article_cta" class="max-w-[580px]" />}
          <div {...macOnly} class="flex flex-wrap items-center gap-3">
            <a
              href={ctaHrefFor('learn_article_cta')}
              rel={targetsBuilders ? 'nofollow' : undefined}
              data-ph-event={ctaEvent}
              data-ph-prop-location="learn_article_cta"
              data-ph-prop-cta-variant="contextual_article"
              data-ph-prop-target-funnel={ctaTargetFunnel}
              data-ph-prop-article-slug={articleSlug}
              data-ph-prop-article-category={data.category}
              data-ph-prop-canonical-keyword={data.canonicalKeyword ?? ''}
              data-ph-prop-cta-text={ctaText}
              data-ph-learn-cta="true"
              class="inline-flex items-center gap-1.5 bg-amber-500 hover:bg-amber-600 text-gray-950 shadow-sm hover:shadow-md rounded-md px-5 py-2.5 text-sm font-semibold transition-all"
            >
              {ctaText}
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12L12 4M12 4H5M12 4V11"/>
              </svg>
            </a>
            <a
              href={secondaryHref}
              data-ph-event="web_learn_more_clicked"
              data-ph-prop-location="learn_article_cta"
              data-ph-prop-article-slug={articleSlug}
              data-ph-prop-article-category={data.category}
              data-ph-prop-target-funnel={ctaTargetFunnel}
              class="inline-flex items-center gap-1.5 bg-white hover:bg-gray-50 text-gray-900 border border-gray-200 hover:border-gray-300 rounded-md px-5 py-2.5 text-sm font-semibold transition-all"
            >
              {secondaryText}
            </a>
            {ctaSubline && <span class="text-[13px] text-gray-600">{ctaSubline}</span>}
          </div>
        </aside>

        {data.faq && data.faq.length > 0 && (
          <section class="mt-16 pt-10 border-t border-gray-200">
            <p class="text-[11px] font-mono tracking-[0.08em] uppercase text-gray-500 mb-4">FAQ</p>
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6 tracking-tight">
              Frequently asked questions
            </h2>
            <div class="flex flex-col gap-3">
              {data.faq.map((q: { question: string; answer: string }) => (
                <details class="group bg-white rounded-xl border border-gray-200 hover:border-amber-500/40 shadow-sm transition-colors">
                  <summary class="list-none cursor-pointer px-6 py-5 flex items-center justify-between gap-4 text-[16px] font-semibold text-gray-900">
                    <span>{q.question}</span>
                    <span aria-hidden="true" class="text-gray-400 text-xl leading-none group-open:rotate-45 transition-transform shrink-0">+</span>
                  </summary>
                  <div class="px-6 pb-6 pt-1 text-[15px] text-gray-600 leading-relaxed">{q.answer}</div>
                </details>
              ))}
            </div>
          </section>
        )}

        {relatedArticles.length > 0 && (
          <section class="mt-16 pt-10 border-t border-gray-200">
            <p class="text-[11px] font-mono tracking-[0.08em] uppercase text-gray-500 mb-4">
              Keep learning
            </p>
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6 tracking-tight">
              Related guides
            </h2>
            <div class="grid gap-3 sm:grid-cols-2">
              {relatedArticles.map(({ entry: relatedEntry, slug: relatedSlug }) => (
                <a
                  href={`/learn/${relatedSlug}/`}
                  data-ph-event="web_learn_related_clicked"
                  data-ph-prop-location="related_guides"
                  data-ph-prop-article-slug={articleSlug}
                  data-ph-prop-article-category={data.category}
                  data-ph-prop-target-article={relatedSlug}
                  data-ph-prop-target-funnel="learn"
                  class="group rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-amber-500/50 hover:shadow-md"
                >
                  <span class="text-[11px] font-mono uppercase tracking-[0.08em] text-amber-700">
                    {categoryLabels[relatedEntry.data.category] ?? relatedEntry.data.category}
                  </span>
                  <h3 class="mt-2 text-base font-semibold leading-snug text-gray-900 group-hover:text-amber-800">
                    {relatedEntry.data.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-gray-600">
                    {relatedEntry.data.description}
                  </p>
                </a>
              ))}
            </div>
          </section>
        )}

      </div>
    </article>
  </main>

  <div
    data-learn-sticky-cta
    hidden
    class="fixed inset-x-3 bottom-3 z-40 mx-auto flex [&[hidden]]:hidden max-w-[760px] items-center gap-3 rounded-xl border border-amber-200 bg-white/95 px-4 py-3 shadow-[0_12px_32px_rgba(38,30,22,0.14)] backdrop-blur-md"
  >
    {!targetsBuilders && (
      <p data-nonmac-only class="min-w-0 flex-1 text-[13px] leading-snug text-gray-800 sm:text-[14px]">
        Not on your Mac right now? Skilly runs on Mac today.
      </p>
    )}
    <p {...macOnly} class="min-w-0 flex-1 text-[13px] leading-snug text-gray-800 sm:text-[14px]">
      <span class="sm:hidden">{stickyCtaShortText}</span>
      <span class="hidden sm:inline">{earlyCtaText}</span>
    </p>
    <a
      {...macOnly}
      href={ctaHrefFor('learn_sticky')}
      rel={targetsBuilders ? 'nofollow' : undefined}
      data-ph-event={ctaEvent}
      data-ph-prop-location="learn_sticky"
      data-ph-prop-cta-variant="sticky_bar"
      data-ph-prop-target-funnel={ctaTargetFunnel}
      data-ph-prop-article-slug={articleSlug}
      data-ph-prop-article-category={data.category}
      data-ph-prop-cta-text={ctaText}
      class="inline-flex shrink-0 items-center rounded-md bg-amber-500 px-4 py-2 text-sm font-semibold text-gray-950 transition-colors hover:bg-amber-600"
    >
      <span class="sm:hidden">Try free</span>
      <span class="hidden sm:inline">{ctaText}</span>
    </a>
    {!targetsBuilders && (
      <a
        href="#learn-waitlist"
        data-waitlist-jump
        class="shrink-0 items-center rounded-md bg-amber-500 px-4 py-2 text-sm font-semibold text-gray-950 transition-colors hover:bg-amber-600"
      >
        Join the waitlist
      </a>
    )}
    <button
      type="button"
      data-learn-sticky-dismiss
      aria-label="Dismiss"
      class="grid h-8 w-8 shrink-0 cursor-pointer place-items-center rounded-md text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900"
    >
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg>
    </button>
  </div>

  <Footer />

  <script is:inline define:vars={{ articleSlug, articleCategory: data.category, ctaTargetFunnel }}>
    (() => {
      const article = document.querySelector('[data-learn-article]');
      if (!article) return;

      const articleCta = document.querySelector('[data-learn-cta]');
      if (articleCta && 'IntersectionObserver' in window) {
        const ctaObserver = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          ctaObserver.disconnect();
          window.skillyTrack?.('web_learn_cta_viewed', {
            article_slug: articleSlug,
            article_category: articleCategory,
            cta_variant: 'contextual_article',
            target_funnel: ctaTargetFunnel,
          });
        }, { threshold: 0.5 });
        ctaObserver.observe(articleCta);
      }

      const stickyCta = document.querySelector('[data-learn-sticky-cta]');
      const stickyDismissedKey = 'skilly_learn_sticky_dismissed';
      if (stickyCta && sessionStorage.getItem(stickyDismissedKey) !== '1') {
        let endCtaVisible = false;
        let stickyViewTracked = false;

        const updateStickyCta = () => {
          const bounds = article.getBoundingClientRect();
          const progress = (window.innerHeight - bounds.top) / Math.max(bounds.height, 1);
          // Hide while the end-of-article CTA is on screen so the offer never shows twice.
          const shouldShow = progress >= 0.4 && !endCtaVisible;
          stickyCta.hidden = !shouldShow;
          if (shouldShow && !stickyViewTracked) {
            stickyViewTracked = true;
            window.skillyTrack?.('web_learn_cta_viewed', {
              article_slug: articleSlug,
              article_category: articleCategory,
              cta_variant: 'sticky_bar',
              target_funnel: ctaTargetFunnel,
            });
          }
        };

        if (articleCta && 'IntersectionObserver' in window) {
          new IntersectionObserver((entries) => {
            endCtaVisible = entries.some((entry) => entry.isIntersecting);
            updateStickyCta();
          }).observe(articleCta);
        }

        stickyCta.querySelector('[data-learn-sticky-dismiss]')?.addEventListener('click', () => {
          sessionStorage.setItem(stickyDismissedKey, '1');
          stickyCta.hidden = true;
          window.removeEventListener('scroll', updateStickyCta);
        });

        window.addEventListener('scroll', updateStickyCta, { passive: true });
        updateStickyCta();
      }

      let captured = false;
      let timer;

      const captureEngagement = (trigger) => {
        if (captured) return;
        captured = true;
        window.removeEventListener('scroll', checkProgress);
        if (timer) window.clearTimeout(timer);
        window.skillyTrack?.('web_learn_article_engaged', {
          article_slug: articleSlug,
          article_category: articleCategory,
          engagement_trigger: trigger,
        });
      };

      const checkProgress = () => {
        const bounds = article.getBoundingClientRect();
        const progress = (window.innerHeight - bounds.top) / Math.max(bounds.height, 1);
        if (progress >= 0.75) captureEngagement('75_percent');
      };

      window.addEventListener('scroll', checkProgress, { passive: true });
      timer = window.setTimeout(() => captureEngagement('45_seconds'), 45_000);
      checkProgress();
    })();
  </script>
</Layout>
