---
const paths = [
  {
    label: 'For Mac users',
    title: 'Learn any app faster.',
    body: 'Ask out loud, let Skilly see your screen, and watch it point to the exact menu or button.',
    href: '/mac',
    cta: 'Explore Mac app',
    targetFunnel: 'mac',
  },
  {
    label: 'For builders',
    title: 'Guide customers inside your site.',
    body: 'Add a voice-and-pointer assistant to your website or app, managed from Studio.',
    href: '/builders',
    cta: 'Explore builders',
    targetFunnel: 'builders',
  },
  {
    label: 'For people',
    title: 'Use guided skills to learn.',
    body: 'Start from bundled skills for creative apps, then request or build the next one.',
    href: '/people',
    cta: 'Explore skills',
    targetFunnel: 'people',
  },
];
---
<section id="products" class="relative py-20 px-6 bg-white">
  <div class="max-w-site mx-auto">
    <div class="max-w-[680px] mb-10">
      <span class="text-[13px] font-semibold text-amber-600 tracking-[1.5px] uppercase">Choose your path</span>
      <h2 data-reveal class="reveal mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900">
        One guide, three jobs.
      </h2>
      <p data-reveal class="reveal reveal-delay-1 mt-4 text-[17px] leading-relaxed text-gray-600">
        Skilly can help you learn on your Mac, help your users inside your website, or package knowledge as reusable skills.
      </p>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {paths.map((path, index) => (
        <a
          href={path.href}
          data-ph-event="web_product_path_clicked"
          data-ph-prop-path={path.label}
          data-ph-prop-target-funnel={path.targetFunnel}
          class={`reveal reveal-delay-${index + 1} group rounded-2xl border border-gray-200 bg-gray-50 p-7 transition-all hover:-translate-y-1 hover:border-amber-500/50 hover:bg-white hover:shadow-md`}
          data-reveal
        >
          <div class="text-[12px] font-semibold tracking-[1.3px] uppercase text-amber-600">{path.label}</div>
          <h3 class="mt-4 text-2xl font-bold tracking-tight text-gray-900">{path.title}</h3>
          <p class="mt-3 min-h-[72px] text-[15px] leading-relaxed text-gray-600">{path.body}</p>
          <div class="mt-6 inline-flex items-center gap-2 text-[15px] font-semibold text-gray-900 group-hover:text-amber-700">
            {path.cta}
            <span aria-hidden="true">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
