---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import SkillyWebWidget from '../components/SkillyWebWidget.astro';
import VideoModal from '../components/VideoModal.astro';
import { BROWSER_EXTENSIONS, DOWNLOAD_URL } from '../data/config.ts';
import { betaTier } from '../data/tiers.ts';
import {
  Apple,
  AudioLines,
  Boxes,
  Brain,
  Check,
  Download,
  Image as ImageIcon,
  Github,
  Heart,
  KeyRound,
  Mic2,
  MousePointer2,
  PanelsTopLeft,
  PenTool,
  Play,
  Share2,
  SearchX,
  Settings,
  Shapes,
  ShieldCheck,
  Smile,
  Sparkles,
  Type,
  Upload,
  Zap,
} from 'lucide-astro';

const DEMO_VIDEO_ID = 'M29K4g5Z_NA';

const stepRail = [
  {
    number: '1',
    title: 'Ask naturally',
    description: 'Speak your question in your own words—no need to know the right keywords.',
    icon: Mic2,
  },
  {
    number: '2',
    title: 'Hear the answer',
    description: 'Skilly replies in voice with clear steps, so you can keep your focus where it matters.',
    icon: AudioLines,
  },
  {
    number: '3',
    title: 'Follow the pointer',
    description: 'Skilly highlights the right controls and clicks when helpful so you never get lost.',
    icon: MousePointer2,
  },
];

const useCases = [
  {
    title: 'Design tools',
    description: 'Get unstuck in Figma, Sketch, Canva, and more.',
    artClass: 'art--design',
  },
  {
    title: 'Video editing',
    description: 'Find the right effect, export settings, or shortcut.',
    artClass: 'art--video',
  },
  {
    title: 'No-code builders',
    description: 'Build faster with guidance inside Webflow, Bubble, Framer, and beyond.',
    artClass: 'art--builder',
  },
  {
    title: 'Developer tools',
    description: 'Ask about Git, Docker, VS Code, and your dev workflow.',
    artClass: 'art--dev',
  },
  {
    title: 'Everyday productivity',
    description: 'Sheets, Slides, Notes—get things done smarter.',
    artClass: 'art--productivity',
  },
];

const benefitCards = [
  {
    title: 'No more hunting for tutorials',
    description: 'Skip the search, skip the videos—get the exact help you need, right now.',
    icon: SearchX,
  },
  {
    title: 'Help in the moment',
    description: 'Contextual answers based on what’s on your screen, not generic advice.',
    icon: Zap,
  },
  {
    title: 'Works the way you think',
    description: 'Ask naturally. Skilly adapts to your tools, your level, and your workflow.',
    icon: Brain,
  },
  {
    title: 'Optional BYOK',
    description: 'Bring your own API key or use our hosted option. You’re in control.',
    icon: KeyRound,
  },
];

const comparisonRows = [
  {
    label: 'Find the right answer',
    videos: 'Takes time',
    docs: 'Hard to find',
    skilly: 'Instant & contextual',
  },
  {
    label: 'Relevant to your screen',
    videos: 'No',
    docs: 'Often generic',
    skilly: 'Yes',
  },
  {
    label: 'Hands-free',
    videos: 'No',
    docs: 'No',
    skilly: 'Yes, voice-first',
  },
  {
    label: 'Shows you where',
    videos: 'No',
    docs: 'Sometimes (screenshots)',
    skilly: 'Yes, pointer guidance',
  },
  {
    label: 'Keeps your flow',
    videos: 'Breaks focus',
    docs: 'Breaks focus',
    skilly: 'Keeps you in the zone',
  },
];

const trustBar = [
  {
    title: 'Open source',
    description: 'Built in the open. You can inspect the code.',
    icon: Github,
  },
  {
    title: 'Privacy first',
    description: 'No audio, screens, or prompts stored in analytics.',
    icon: ShieldCheck,
  },
  {
    title: 'BYOK optional',
    description: 'Use your own key or our hosted option.',
    icon: KeyRound,
  },
  {
    title: 'Made for Mac',
    description: 'Native experience. Lightweight. Always ready.',
    icon: Apple,
  },
];

const faqs = [
  {
    question: 'How long is the free trial?',
    answer: 'Skilly includes 15 minutes of real hosted usage with no card required. Most people know within the first session whether voice guidance and pointing are useful for them.',
  },
  {
    question: 'Which apps does Skilly work with?',
    answer: 'Skilly works in any app on your Mac. App-specific skills make it better by adding lessons, vocabulary, and current documentation.',
  },
  {
    question: 'Can I use Skilly in my browser?',
    answer: 'Yes. Skilly is available as an extension for Google Chrome, Microsoft Edge, and Mozilla Firefox. The extension provides voice guidance and pointing on the webpage you choose.',
  },
  {
    question: 'Is Skilly private?',
    answer: 'Audio and screen context are sent only while you ask for help. Message contents are not sent to analytics. Conversation history, including optional replay audio, stays locally on your device.',
  },
  {
    question: 'Can I build my own skill?',
    answer: 'Yes. You can create private skills for the tools you want to learn, refine them during lessons, and share the best ones later.',
  },
  {
    question: 'What happens when I hit my hosted minutes?',
    answer: 'Hosted usage pauses until the next cycle. There are no surprise overage charges, and Skilly warns you as you approach the limit.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---
<Layout
  title="Skilly for Mac - Ask your apps what to do next"
  description="Skilly for Mac listens to your question, replies in voice, and guides you through the app you’re using without forcing you to search tutorials."
  productLine="people"
  funnelStage="conversion"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>
  <Nav />

  <main class="people-page overflow-x-clip bg-[#fffaf6] text-[#231d1a]">
    <div class="sr-only" itemscope itemtype="https://schema.org/SoftwareApplication">
      <h2 itemprop="name">Skilly for Mac</h2>
      <p itemprop="description">
        Skilly listens to your question, answers in voice, and points at the exact control to use next inside the app you are already using.
      </p>
      <span itemprop="operatingSystem">macOS 14+, Google Chrome, Microsoft Edge, Mozilla Firefox</span>
      <span itemprop="applicationCategory">EducationalApplication</span>
    </div>

    <section class="people-hero relative isolate border-b border-[#f4e7df]">
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-[radial-gradient(circle_at_14%_18%,rgba(255,154,102,0.18),transparent_24%),radial-gradient(circle_at_78%_10%,rgba(255,123,68,0.16),transparent_22%),linear-gradient(180deg,#fffaf6_0%,#fff6f0_100%)]"
      ></div>

      <div class="people-hero-inner relative mx-auto grid max-w-[1360px] gap-10 px-5 pb-10 pt-8 sm:px-8 lg:grid-cols-[0.82fr_1.18fr] lg:items-center lg:gap-8">
        <div class="people-hero-copy max-w-[470px]">
          <div class="font-mono text-[12px] font-semibold tracking-[0.18em] text-[#ff6f3f]">
            VOICE GUIDANCE FOR YOUR APPS
          </div>

          <h1 class="mt-6 max-w-[520px] text-[48px] font-bold leading-[0.92] tracking-[-0.055em] text-[#2a2421] sm:text-[66px]">
            Ask your apps
            <br />
            what to do
            <span class="text-[#ff6f3f]"> next.</span>
          </h1>

          <p class="mt-6 max-w-[430px] text-[18px] leading-[1.65] text-[#5f534d]">
            Skilly for Mac listens to your question, replies in voice, and guides you through the app you’re using—without forcing you to search tutorials.
          </p>

          <div class="people-hero-actions mt-8 flex flex-wrap gap-3">
            <a
              href={DOWNLOAD_URL}
              data-ph-event="web_cta_download_clicked"
              data-ph-prop-location="people_hero"
              data-ph-prop-target-funnel="people"
              class="inline-flex h-14 items-center gap-2 rounded-[14px] bg-[#ff6f3f] px-6 text-[18px] font-semibold text-white shadow-[0_18px_40px_rgba(255,111,63,0.22)] transition hover:-translate-y-0.5 hover:bg-[#ff6735]"
            >
              <Download size={19} strokeWidth={1.8} aria-hidden="true" />
              Download for Mac
            </a>

            <button
              type="button"
              data-video-modal-open={DEMO_VIDEO_ID}
              data-ph-event="web_demo_video_played"
              data-ph-prop-location="people_hero"
              class="inline-flex h-14 items-center gap-3 rounded-[14px] border border-[#ead8cf] bg-white px-6 text-[18px] font-semibold text-[#2a2421] shadow-[0_8px_24px_rgba(91,57,38,0.05)] transition hover:border-[#ffcfbe]"
            >
              <span class="flex h-7 w-7 items-center justify-center rounded-full border border-[#2a2421]/30"><Play size={13} strokeWidth={1.8} fill="currentColor" aria-hidden="true" /></span>
              Watch demo
            </button>
          </div>

          <div class="people-hero-assurances mt-10 grid max-w-[470px] grid-cols-3 gap-3 text-[13px] text-[#5d514a]">
            <div class="rounded-[16px] border border-[#f1e0d7] bg-white/85 px-3 py-3 shadow-[0_8px_20px_rgba(91,57,38,0.04)]">
              <KeyRound size={18} strokeWidth={1.8} class="text-[#f39a50]" aria-hidden="true" />
              <p class="mt-2 leading-[1.4]">Bring your own key optional</p>
            </div>
            <div class="rounded-[16px] border border-[#f1e0d7] bg-white/85 px-3 py-3 shadow-[0_8px_20px_rgba(91,57,38,0.04)]">
              <PanelsTopLeft size={18} strokeWidth={1.8} class="text-[#f39a50]" aria-hidden="true" />
              <p class="mt-2 leading-[1.4]">Works across apps</p>
            </div>
            <div class="rounded-[16px] border border-[#f1e0d7] bg-white/85 px-3 py-3 shadow-[0_8px_20px_rgba(91,57,38,0.04)]">
              <MousePointer2 size={18} strokeWidth={1.8} class="text-[#f39a50]" aria-hidden="true" />
              <p class="mt-2 leading-[1.4]">Voice + pointer guidance</p>
            </div>
          </div>
        </div>

        <div class="people-hero-scene relative lg:pl-2">
          <div class="device-shell relative mx-auto w-full max-w-[760px] rounded-[34px] border-[8px] border-[#27221f] bg-[#f7f3ef] shadow-[0_28px_80px_rgba(67,36,23,0.24)]">
            <div class="flex h-11 items-center justify-between border-b border-[#e8dfd8] bg-[#faf8f6] px-4">
              <div class="flex items-center gap-2">
                <span class="h-3 w-3 rounded-full bg-[#ff695c]"></span>
                <span class="h-3 w-3 rounded-full bg-[#ffcd53]"></span>
                <span class="h-3 w-3 rounded-full bg-[#5ad06c]"></span>
              </div>
              <div class="text-[11px] font-medium text-[#6f6560]">Project&nbsp; / &nbsp;Social Post</div>
              <div class="flex items-center gap-2 text-[#625852]"><Play size={14} strokeWidth={1.8} /><span class="rounded-md bg-white px-2.5 py-1 text-[10px] shadow-sm">Share</span></div>
            </div>

            <div class="grid h-[560px] grid-cols-[104px_minmax(0,1fr)_138px] overflow-hidden">
              <aside class="border-r border-[#e8dfd8] bg-[#fbfaf8] px-3 py-4 text-[10px] text-[#665d57]">
                <div class="space-y-3.5">
                  <div class="flex items-center gap-2 font-semibold text-[#302b28]"><MousePointer2 size={13} strokeWidth={1.7} />Select</div>
                  <div class="flex items-center gap-2"><Shapes size={13} strokeWidth={1.7} />Shape</div>
                  <div class="flex items-center gap-2"><Type size={13} strokeWidth={1.7} />Text</div>
                  <div class="flex items-center gap-2"><ImageIcon size={13} strokeWidth={1.7} />Image</div>
                  <div class="flex items-center gap-2"><Boxes size={13} strokeWidth={1.7} />Components</div>
                  <div class="flex items-center gap-2"><Upload size={13} strokeWidth={1.7} />Uploads</div>
                  <div class="flex items-center gap-2"><PanelsTopLeft size={13} strokeWidth={1.7} />Templates</div>
                </div>
              </aside>

              <div class="relative grid place-items-center bg-[#f4f2f0] p-7">
                <div class="relative aspect-[4/3] w-[78%] border-2 border-[#7598ff] bg-[#f8ede5] shadow-[0_16px_30px_rgba(82,60,48,0.08)]">
                  <div class="absolute left-[10%] top-[11%] max-w-[120px] font-serif text-[23px] leading-[1.05] text-[#27211e]">Elevate<br />your space.</div>
                  <div class="absolute bottom-[18%] left-[16%] h-[72px] w-[72px] rounded-full bg-[radial-gradient(circle_at_35%_28%,#fff8f0_0%,#efd1bd_48%,#cf9b7b_100%)] shadow-[0_15px_18px_rgba(95,57,38,0.17)]"></div>
                  <div class="absolute bottom-[16%] right-[15%] h-[118px] w-[92px] rounded-t-[46px] bg-[linear-gradient(135deg,#f6be7b_0%,#f28a4b_100%)] shadow-[0_18px_24px_rgba(134,75,33,0.2)]"><div class="absolute inset-x-[24px] bottom-0 top-[30px] rounded-t-[22px] bg-[#f8ede5]"></div></div>
                  <div class="absolute bottom-[6%] left-1/2 -translate-x-1/2 text-[8px] text-[#6d5e55]">Shop the collection →</div>
                  <span class="absolute -left-1 -top-1 h-2 w-2 bg-white ring-1 ring-[#7598ff]"></span><span class="absolute -right-1 -top-1 h-2 w-2 bg-white ring-1 ring-[#7598ff]"></span><span class="absolute -bottom-1 -left-1 h-2 w-2 bg-white ring-1 ring-[#7598ff]"></span><span class="absolute -bottom-1 -right-1 h-2 w-2 bg-white ring-1 ring-[#7598ff]"></span>
                </div>
                <MousePointer2 size={36} strokeWidth={1.6} fill="#ff7145" class="absolute bottom-[24%] right-[14%] text-[#ff7145] drop-shadow-md" aria-hidden="true" />
              </div>

              <aside class="border-l border-[#e8dfd8] bg-[#fbfaf8] px-3 py-4 text-[9px] text-[#675d57]">
                <div class="flex items-center justify-between border-b border-[#e8dfd8] pb-3 font-semibold text-[#302b28]"><span>Design</span><Settings size={13} strokeWidth={1.7} /></div>
                <div class="mt-4 space-y-3">
                  <div><div class="mb-1 text-[#91857e]">Frame</div><div class="grid grid-cols-2 gap-1"><span class="rounded border border-[#e4dbd5] bg-white p-1">X&nbsp; 240</span><span class="rounded border border-[#e4dbd5] bg-white p-1">Y&nbsp; 120</span></div></div>
                  <div><div class="mb-1 text-[#91857e]">Radius</div><div class="rounded border border-[#e4dbd5] bg-white p-1.5">24</div></div>
                  <div><div class="mb-1 text-[#91857e]">Fill</div><div class="rounded border border-[#e4dbd5] bg-white p-1.5">#F9E7DE</div></div>
                  <div><div class="mb-1 text-[#91857e]">Shadow</div><div class="grid grid-cols-3 gap-1"><span class="rounded border bg-white p-1">0</span><span class="rounded border bg-white p-1">8</span><span class="rounded border bg-white p-1">24</span></div></div>
                </div>
              </aside>
            </div>

            <div class="flex h-14 items-center justify-center gap-3 bg-[linear-gradient(90deg,#ce5b2c_0%,#f39355_45%,#d75a2c_100%)]">
              {[PanelsTopLeft, PenTool, ImageIcon, Boxes, Share2, Settings].map((DockIcon) => <span class="grid h-9 w-9 place-items-center rounded-[10px] border border-white/30 bg-white/90 text-[#554944] shadow-md"><DockIcon size={17} strokeWidth={1.7} /></span>)}
            </div>
          </div>

          <div class="hero-widget absolute right-0 top-[92px] z-30 hidden min-h-[560px] w-[244px] flex-col rounded-[22px] border border-[#4f4039] bg-[#211c1a] p-5 text-white shadow-[0_22px_55px_rgba(33,22,18,0.38)] sm:flex lg:right-[-8px]">
            <div class="flex items-center justify-between"><div class="flex items-center gap-2"><Logo size={22} variant="amber" alt="" /><span class="font-semibold">Skilly</span></div><Settings size={15} strokeWidth={1.7} class="text-white/60" /></div>
            <div class="mt-7 text-center text-[11px] text-white/55">Listening...</div>
            <div class="mt-3 flex h-8 items-center justify-center gap-1">{[12,20,14,28,18,24,13,20,11].map((height) => <span class="w-1 rounded-full bg-[#ff7045]" style={`height:${height}px`}></span>)}</div>
            <div class="mx-auto mt-4 grid h-14 w-14 place-items-center rounded-full bg-[#ff6847] shadow-[0_0_0_9px_rgba(255,104,71,0.12)]"><Mic2 size={24} strokeWidth={1.8} /></div>
            <div class="mt-auto space-y-3 text-[12px] leading-[1.5]"><div class="rounded-xl bg-white/8 p-3.5 text-white/70">How do I add rounded corners to this card?</div><div class="rounded-xl bg-white/8 p-3.5">Select the shape tool, then adjust the corner radius here.</div></div>
            <MousePointer2 size={25} strokeWidth={1.7} fill="#ff7045" class="ml-auto mt-4 text-[#ff7045]" />
          </div>
        </div>
      </div>
    </section>

    <section id="how" class="people-steps border-b border-[#f1e5de] bg-white/75">
      <div class="people-steps-inner mx-auto grid max-w-[1360px] gap-4 px-5 py-8 sm:px-8 md:grid-cols-3 md:gap-0">
        {stepRail.map(({ icon: Icon, ...step }, index) => (
          <article class={`step-card relative flex gap-4 px-0 md:px-7 ${index < stepRail.length - 1 ? 'md:border-r md:border-[#efe3db]' : ''}`}>
            <div class="mt-0.5 flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-[linear-gradient(180deg,#ffe7dc_0%,#ffd2be_100%)] text-[#2a2421] shadow-[0_10px_18px_rgba(255,111,63,0.08)]"><Icon size={25} strokeWidth={1.8} aria-hidden="true" /></div>
            <div>
              <div class="text-[24px] font-bold leading-none text-[#ff6f3f]">{step.number}</div>
              <h2 class="mt-1 text-[18px] font-semibold text-[#2a2421]">{step.title}</h2>
              <p class="mt-2 max-w-[280px] text-[14px] leading-[1.6] text-[#5f534d]">{step.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="use-cases" class="people-use-cases mx-auto max-w-[1360px] px-5 py-10 sm:px-8">
      <div class="text-center">
        <h2 class="inline-block text-[42px] font-bold leading-none tracking-[-0.04em] text-[#2a2421]">
          Use it when...
          <Sparkles size={23} strokeWidth={1.8} class="ml-2 inline-block translate-y-[-8px] text-[#ff9f70]" aria-hidden="true" />
        </h2>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-5">
        {useCases.map((useCase) => (
          <article class="use-case-card rounded-[24px] border border-[#f2e6df] bg-[linear-gradient(180deg,#fffdfa_0%,#fff6f0_100%)] px-4 pb-5 pt-4 shadow-[0_12px_30px_rgba(111,73,48,0.04)]">
            <div class={`use-case-art ${useCase.artClass}`} aria-hidden="true"><span></span><span></span><span></span></div>
            <h3 class="mt-4 text-[18px] font-semibold leading-[1.2] text-[#2a2421]">{useCase.title}</h3>
            <p class="mt-3 text-[14px] leading-[1.55] text-[#5f534d]">{useCase.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="people-benefits mx-auto max-w-[1360px] px-5 pb-10 sm:px-8">
      <div class="text-center">
        <h2 class="inline-block text-[40px] font-bold leading-none tracking-[-0.04em] text-[#2a2421]">
          Why people love Skilly
          <Heart size={25} strokeWidth={1.8} class="ml-2 inline-block text-[#ffb08d]" aria-hidden="true" />
        </h2>
      </div>

      <div class="mt-7 grid gap-4 md:grid-cols-4">
        {benefitCards.map(({ icon: Icon, ...card }) => (
          <article class="rounded-[22px] border border-[#f2e6df] bg-white px-5 py-5 shadow-[0_12px_26px_rgba(111,73,48,0.04)]">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[linear-gradient(180deg,#ffe8df_0%,#ffd0bc_100%)] text-[#8a5938]"><Icon size={21} strokeWidth={1.8} aria-hidden="true" /></div>
            <h3 class="text-[16px] font-semibold leading-[1.35] text-[#2a2421]">{card.title}</h3>
            <p class="mt-2 text-[13.5px] leading-[1.6] text-[#5f534d]">{card.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="people-extensions mx-auto max-w-[1360px] px-5 pb-10 sm:px-8" aria-labelledby="browser-extension-heading">
      <div class="grid items-center gap-7 overflow-hidden rounded-[26px] border border-[#f0ddd4] bg-[#2a2421] px-6 py-7 text-white shadow-[0_18px_40px_rgba(67,36,23,0.12)] md:grid-cols-[1fr_auto] md:px-8">
        <div>
          <div class="font-mono text-[11px] font-semibold uppercase tracking-[0.16em] text-[#ff9f70]">Already in your browser</div>
          <h2 id="browser-extension-heading" class="mt-3 text-[30px] font-bold leading-[1.05] tracking-[-0.04em] sm:text-[38px]">Ask the page you are on.</h2>
          <p class="mt-3 max-w-[620px] text-[15px] leading-[1.65] text-white/65">Use Skilly on the web without leaving your tab. Ask by voice, hear the answer, and follow the pointer to the right control.</p>
        </div>
        <div class="grid gap-2.5 sm:grid-cols-3 md:grid-cols-1 lg:grid-cols-3">
          {BROWSER_EXTENSIONS.map((extension) => (
            <a
              href={extension.href}
              target="_blank"
              rel="noopener noreferrer"
              data-ph-event="web_extension_store_clicked"
              data-ph-prop-browser={extension.id}
              data-ph-prop-location="people_extensions"
              class="inline-flex min-w-[142px] items-center justify-between gap-3 rounded-[13px] border border-white/10 bg-white/[0.08] px-4 py-3 text-[14px] font-semibold text-white transition hover:-translate-y-0.5 hover:border-[#ff9f70]/50 hover:bg-white/[0.12]"
            >
              <span>{extension.shortName}</span>
              <span aria-hidden="true" class="text-[#ff9f70]">↗</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="people-comparison mx-auto max-w-[1360px] px-5 pb-10 sm:px-8">
      <div class="overflow-hidden rounded-[24px] border border-[#f0ddd4] bg-white shadow-[0_12px_32px_rgba(111,73,48,0.05)]">
        <div class="overflow-x-auto">
          <table class="min-w-full border-collapse text-left">
            <thead>
              <tr class="bg-[linear-gradient(180deg,#fff8f2_0%,#fff3eb_100%)]">
                <th class="border-b border-[#f0ddd4] px-6 py-4 text-[15px] font-semibold text-[#43352f]">How you get help</th>
                <th class="border-b border-[#f0ddd4] px-6 py-4 text-[15px] font-semibold text-[#43352f]">Search videos</th>
