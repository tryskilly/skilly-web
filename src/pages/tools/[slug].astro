---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const pages = {
  'product-tour-script-generator': {
    title: 'Free product tour script generator',
    h1: 'Generate a product tour script from your onboarding goal.',
    description: 'Write the first-run script your AI guide should say before it points users to the right control.',
    example: 'User asks where to start. Skilly explains the setup action, points at the primary CTA, and confirms the next screen.',
    intent: 'product tour script generator',
  },
  'user-onboarding-checklist': {
    title: 'Free user onboarding checklist',
    h1: 'Find the onboarding steps your product must explain.',
    description: 'Turn activation goals into a practical checklist for first-run guidance, docs, and in-product help.',
    example: 'Goal, first action, expected next screen, fallback help, completion signal.',
    intent: 'user onboarding checklist',
  },
  'in-app-help-generator': {
    title: 'Free in-app help generator',
    h1: 'Generate contextual help prompts for your product.',
    description: 'Create the plain-language answers a voice guide should use when users get stuck inside your app.',
    example: 'What is this page? Where do I start? What happens after I click this?',
    intent: 'in-app help generator',
  },
  'ai-product-tour-generator': {
    title: 'Free AI product tour generator',
    h1: 'Draft the AI-guided tour your users can ask for.',
    description: 'Use your product URL and activation goal to create a Skilly-ready first tour path.',
    example: 'Ask, answer, point, confirm, continue.',
    intent: 'AI product tour generator',
  },
};

export function getStaticPaths() {
  return [
    'product-tour-script-generator',
    'user-onboarding-checklist',
    'in-app-help-generator',
    'ai-product-tour-generator',
  ].map((slug) => ({ params: { slug } }));
}

const page = pages[Astro.params.slug as keyof typeof pages];
const auditHref = '/tools/ai-onboarding-audit/';
---
<Layout title={`${page.title} - Skilly`} description={page.description} productLine="builders" funnelStage="awareness">
  <Nav />
  <main id="top" class="overflow-x-clip bg-[#FAF8F4] text-[#1A1714]">
    <section class="mx-auto max-w-5xl px-5 pb-14 pt-24 sm:px-8 lg:pt-28">
      <p class="font-mono text-[12px] tracking-[0.04em] text-[#9A5B08]">Free onboarding tool</p>
      <h1 class="mt-5 max-w-3xl text-[42px] font-bold leading-[1.03] tracking-tight sm:text-[56px]">{page.h1}</h1>
      <p class="mt-6 max-w-2xl text-[18px] leading-relaxed text-[#6B635A]">{page.description}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={auditHref} class="inline-flex items-center rounded-xl bg-[#F59E0B] px-6 py-3.5 font-semibold text-[#1A1714] transition hover:brightness-105 active:scale-[0.98]">Run the AI audit</a>
        <a href="https://studio.tryskilly.app/signup" rel="nofollow" data-ph-event="web_ai_audit_studio_clicked" data-ph-prop-location={`tool_${page.intent}`} data-ph-prop-target-funnel="builders" class="inline-flex items-center rounded-xl border border-[#E8E2D9] bg-white px-5 py-3.5 font-semibold transition hover:border-[#F59E0B]/40 active:scale-[0.98]">Open Studio</a>
      </div>
    </section>
    <section class="border-y border-[#E8E2D9] bg-white">
      <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8">
        <h2 class="text-2xl font-bold tracking-tight">What the generator produces</h2>
        <div class="mt-6 rounded-3xl border border-[#E8E2D9] bg-[#FAF8F4] p-6">
          <p class="font-mono text-[13px] leading-relaxed text-[#4E463D]">{page.example}</p>
        </div>
      </div>
    </section>
    <section class="mx-auto max-w-5xl px-5 py-14 sm:px-8">
      <h2 class="text-2xl font-bold tracking-tight">Best next step</h2>
      <p class="mt-3 max-w-2xl text-[16px] leading-relaxed text-[#6B635A]">The audit looks at your public site first, then turns the gaps into a script, checklist, and SKILL.md preview.</p>
      <a href={auditHref} class="mt-6 inline-flex items-center rounded-xl bg-[#1A1714] px-6 py-3.5 font-semibold text-white transition hover:bg-[#2A251F] active:scale-[0.98]">Audit my product</a>
    </section>
  </main>
  <Footer />
</Layout>
