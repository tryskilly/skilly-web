---
// src/pages/checkout-success.astro
// Polar returns Mac and BYOK payers to /checkout-success?uid=… (no trailing
// slash). trailingSlash: 'always' 308s that form to /checkout-success/ before
// any page route runs; both forms still render this page. A per-path 200 would
// require a Vercel route ahead of that enforcer.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';

const deepLink = 'skilly://checkout-success';
---
<Layout title="You're in — Skilly" description="Your subscription is active. Open Skilly to continue." productLine="people" funnelStage="conversion" noindex>
  <Nav />
  <main class="flex min-h-[70vh] items-center justify-center bg-[#fffefa] px-6">
    <div class="text-center max-w-md">
      <div class="text-5xl mb-6">
        <img src="/skilly-mark.png" alt="Skilly" class="w-16 h-16 mx-auto" onerror="this.style.display='none'" />
      </div>
      <h1 class="mb-3 text-3xl font-bold text-[#24211f]">You're in!</h1>
      <p class="mb-6 text-lg text-[#6f6864]">
        Thanks for subscribing. Open Skilly and your plan will refresh on its own.
      </p>
      <Button
        href={deepLink}
        variant="people-primary"
        size="lg"
        class="mb-4"
        data-ph-event="checkout_open_app_clicked"
        data-ph-prop-location="checkout_success"
      >
        Open Skilly
      </Button>
      <p class="text-sm text-[#756e69]">
        Skilly didn't open? Make sure it's in Applications and open it from there.
        <a href="/download/" class="font-medium text-[#24211f] underline underline-offset-2">Download Skilly</a>
        if it isn't installed yet, then follow the install steps: open the disk image and move Skilly into Applications.
      </p>
    </div>
  </main>
  <Footer />
  <script is:inline define:vars={{ deepLink }}>
    // uid is the WorkOS id Polar was given so this browser can identify the
    // same PostHog person as the Mac app. The deep link does not take it:
    // the app only matches the host checkout-success and refreshes entitlement.
    (() => {
      const params = new URLSearchParams(window.location.search);
      const uid = params.get('uid');
      const props = {
        source: 'web_checkout',
        source_surface: 'marketing_site',
        product_line: 'people',
        funnel_stage: 'conversion',
      };

      window.posthog?.capture('checkout_success_viewed', props);

      if (uid) {
        window.posthog?.identify(uid, {
          source: 'web_checkout',
          source_surface: 'marketing_site',
        });
        window.posthog?.capture('web_checkout_completed', props);
        window.gtag?.('event', 'web_checkout_completed', props);

        params.delete('uid');
        const cleanedQuery = params.toString();
        const cleanedUrl =
          window.location.pathname + (cleanedQuery ? `?${cleanedQuery}` : '') + window.location.hash;
        window.history.replaceState({}, document.title, cleanedUrl);
      }

      window.setTimeout(() => {
        window.location.assign(deepLink);
      }, 300);
    })();
  </script>
</Layout>
