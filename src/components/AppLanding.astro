---
// Shared landing page for one bundled creative app.
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import NonMacWaitlist from '../components/NonMacWaitlist.astro';
import { trackedDownloadUrl } from '../data/config.ts';
import { askApps, askAppBySlug } from '../data/askExamples.ts';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const app = askAppBySlug(slug);
if (!app) {
  throw new Error(`No bundled app landing page for ${slug}`);
}

const others = askApps.filter((candidate) => candidate.slug !== app.slug);
const downloadHref = trackedDownloadUrl('app', app.slug, 'download');
const location = `app_${app.slug.replace(/-/g, '_')}`;
---
<Layout title={app.title} description={app.description} productLine="people" funnelStage="consideration">
  <Nav />
  <main class="overflow-x-clip">
    <article class="mx-auto max-w-[820px] px-6 pb-20 pt-32 lg:pt-40">
      <p class="text-[11px] font-mono uppercase tracking-[0.08em] text-amber-700">{app.name}</p>
      <h1 class="mt-4 text-4xl font-bold leading-[1.1] tracking-tight text-gray-900 sm:text-5xl">
        {app.title}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-gray-600">
        Say it the way you would to someone sitting next to you. Skilly hears the question and points at the control.
        It never clicks, and it never moves your cursor.
      </p>
      <p class="mt-3 text-[15px] leading-relaxed text-gray-600">
        These are tasks the bundled {app.name} skill actually teaches.
        The longer walkthrough is the
        <a href={app.guideHref} class="font-medium text-gray-900 underline underline-offset-2">beginner guide</a>.
      </p>

      <ol class="mt-8 flex flex-col gap-3">
        {app.questions.map((example, index) => (
          <li>
            <a
              href={example.learnHref}
              data-ph-event="web_learn_related_clicked"
              data-ph-prop-location={location}
              data-ph-prop-target-article={example.learnHref.replace(/^\/learn\//, '').replace(/\/$/, '')}
              class="flex gap-3 rounded-2xl border border-gray-200 bg-white px-4 py-4 text-[16px] leading-snug text-gray-800 shadow-sm transition hover:border-amber-300"
            >
              <span class="font-mono text-[13px] text-amber-700">{index + 1}</span>
              <span>“{example.question}”</span>
            </a>
          </li>
        ))}
      </ol>

      <section class="mt-10 rounded-2xl border border-amber-200/70 bg-amber-50/70 p-6">
        <h2 class="text-xl font-semibold text-gray-900">Try it on your Mac</h2>
        <p class="mt-2 text-[15px] leading-relaxed text-gray-700">
          15-minute trial, no card. macOS 14.2 or later.
        </p>
        <NonMacWaitlist id="get-skilly" location={location} class="mt-4" />
        <div class="mt-4" data-mac-download>
          <Button
            href={downloadHref}
            variant="people-primary"
            size="lg"
            data-ph-event="web_cta_download_clicked"
            data-ph-prop-location={location}
            data-ph-prop-target-funnel="people"
            data-ph-prop-cta-text="Download for Mac"
          >
            Download for Mac
          </Button>
        </div>
      </section>

      <nav class="mt-10" aria-label="Other apps">
        <h2 class="text-lg font-semibold text-gray-900">Ask about another app</h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {others.map((other) => (
            <li>
              <a href={`/${other.slug}/`} class="inline-flex rounded-full border border-gray-200 bg-white px-3 py-1.5 text-[14px] font-medium text-gray-800 hover:border-amber-300">
                {other.name}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </article>
  </main>
  <Footer />
</Layout>
