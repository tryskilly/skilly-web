---
// /vs/clicky/ — Clicky alternative.
// Skilly claims: public/pricing.md, /privacy-first/ facts, and the tryskilly/skilly LICENSE + README.
// HeyClicky claims: only https://www.heyclicky.com/ , https://www.heyclicky.com/for-mac ,
// and https://github.com/farzaa/clicky . Each statement below links its source.

import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Button from '../../components/Button.astro';
import NonMacWaitlist from '../../components/NonMacWaitlist.astro';
import { trackedDownloadUrl } from '../../data/config.ts';

const title = 'Clicky alternative for creative apps | Skilly';
const description =
  'Skilly is Apache-2.0 open source, with bundled creative-app skills and an own-key plan. Sources for each HeyClicky note are linked on this page.';

const skills = [
  { name: 'Premiere Pro', href: '/premiere-pro/' },
  { name: 'DaVinci Resolve', href: '/davinci-resolve/' },
  { name: 'After Effects', href: '/after-effects/' },
  { name: 'Blender', href: '/blender/' },
  { name: 'Figma', href: '/figma/' },
];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: 'https://tryskilly.app/vs/clicky/',
  about: [
    { '@type': 'SoftwareApplication', name: 'Skilly', applicationCategory: 'EducationalApplication', operatingSystem: 'macOS 14.2 or later' },
    { '@type': 'SoftwareSourceCode', name: 'Clicky', codeRepository: 'https://github.com/farzaa/clicky', license: 'https://github.com/farzaa/clicky/blob/main/LICENSE' },
  ],
};

const link = 'font-medium text-gray-900 underline underline-offset-2';
---
<Layout title={title} description={description} productLine="people" funnelStage="consideration">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(productSchema)} />
  </Fragment>
  <Nav />

  <main class="overflow-x-clip">
    <section class="relative mx-auto max-w-site px-6 pb-8 pt-32 lg:pt-40">
      <div class="mx-auto max-w-[820px] text-center">
        <p class="mb-4 text-sm font-medium uppercase tracking-wide text-amber-700">Skilly and HeyClicky</p>
        <h1 class="mb-6 text-4xl font-bold leading-[1.1] tracking-tight text-gray-900 sm:text-5xl">
          Clicky alternative
        </h1>
        <p class="mx-auto mb-8 max-w-[680px] text-lg leading-relaxed text-gray-600">
          Skilly is a Mac tutor that points at the control while you do the step.
          HeyClicky is the app at heyclicky.com, and the open-source project it grew out of is on GitHub.
          This page only says what those sources say, and links each one.
        </p>
        <NonMacWaitlist
          id="get-skilly"
          location="vs_clicky_hero"
          class="mx-auto mb-5 max-w-[560px] rounded-2xl border border-amber-200/70 bg-white px-5 py-4 shadow-sm"
        />
        <p class="mb-4 text-[15px] text-gray-700">15-minute trial, no card. macOS 14.2 or later.</p>
        <Button
          data-mac-download
          href={trackedDownloadUrl('vs', 'vs_clicky_hero', 'clicky')}
          variant="builders-accent"
          size="lg"
          data-ph-event="web_cta_download_clicked"
          data-ph-prop-location="vs_clicky_hero"
          data-ph-prop-target-funnel="people"
          data-ph-prop-cta-text="Download for Mac"
        >
          Download for Mac
        </Button>
      </div>
    </section>

    <section class="mx-auto max-w-site px-6 pb-12">
      <div class="mx-auto max-w-[760px] space-y-10 text-[15px] leading-relaxed text-gray-700">
        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900">Open source</h2>
          <p class="mt-3">
            Skilly is Apache-2.0 open source. The license text is the
            <a class={link} href="https://github.com/tryskilly/skilly/blob/main/LICENSE">LICENSE</a>
            in tryskilly/skilly.
          </p>
          <p class="mt-3">
            The Skilly README says Skilly is a fork of farzaa/clicky, and that the original Clicky code is MIT.
            <a class={link} href="https://github.com/tryskilly/skilly/blob/main/README.md">README</a>.
          </p>
          <p class="mt-3">
            <a class={link} href="https://github.com/farzaa/clicky">github.com/farzaa/clicky</a>
            is the MIT open-source origin. Its README calls it the open-source project HeyClicky grew out of, says the existing codebase remains open source (“It’s an MIT license”), and says newer HeyClicky work is private. The same README says “Download HeyClicky for free” and links the Mac and Windows downloads.
          </p>
          <p class="mt-3">
            The current app is
            <a class={link} href="https://www.heyclicky.com/">heyclicky.com</a>,
            “an ai buddy for mac and windows.” The Mac page is
            <a class={link} href="https://www.heyclicky.com/for-mac">heyclicky.com/for-mac</a>.
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900">Your own key</h2>
          <p class="mt-3">
            Bring your own OpenAI key: $5/month plus your OpenAI usage.
            The hosted plan is Skilly for People Beta — $19/month, with 3 hours of live AI tutoring per month.
            15-minute trial, no card.
            <a class={link} href="/pricing/">Full pricing</a>.
            Setup is the
            <a class={link} href="/learn/skilly-openai-key-setup/">Skilly OpenAI API key setup</a>.
          </p>
          <p class="mt-3">
            The open-source Clicky README’s manual setup uses your own Anthropic, AssemblyAI, and ElevenLabs keys, plus a Cloudflare Worker.
            That paragraph is about the repo, not a description of the HeyClicky app.
            <a class={link} href="https://github.com/farzaa/clicky#manual-setup">Manual setup</a>.
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900">Creative-app skills</h2>
          <p class="mt-3">
            Built-in skills for Premiere Pro, DaVinci Resolve, After Effects, Blender and Figma. Houdini is coming soon and not bundled in the app yet.
          </p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {skills.map((skill) => (
              <li>
                <a href={skill.href} class="inline-flex rounded-full border border-gray-200 bg-white px-3 py-1.5 text-[14px] font-medium text-gray-800 hover:border-amber-300">
                  {skill.name}
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-3">
            The HeyClicky Mac page says it “works in the apps you use” and names Final Cut Pro, Logic Pro, Xcode, Figma, Excel, DaVinci Resolve, Blender, Safari, and System Settings. It also says: “if it’s on your screen, heyclicky can see it and walk you through it.”
            <a class={link} href="https://www.heyclicky.com/for-mac">for Mac</a>.
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900">What happens when you ask</h2>
          <p class="mt-3">
            On Skilly, the default shortcut is Control+Option. Hold it and ask out loud. Skilly points at the control. It never clicks, and it never moves your cursor. Live Tutor mode is hands-free voice activation (no hotkey required). Skilly requires macOS 14.2 or later.
          </p>
          <p class="mt-3">
            The HeyClicky homepage says: press the hotkey and it sees what you see, so you can ask it anything out loud and it will walk you through whatever you are working on, or say “heyclicky agent” and it will go do the task for you.
            <a class={link} href="https://www.heyclicky.com/">Homepage FAQ</a>.
          </p>
          <p class="mt-3">
            The Mac page says the same walkthrough, and that you can hand it a task and it will go do it for you. It runs on macOS Sonoma 14.2 or higher, on Apple silicon and Intel. Hold the shortcut, ask out loud, and it helps with whatever is on your screen. It lives in the Mac notch. Setup asks you to allow the microphone, accessibility, and screen recording.
            <a class={link} href="https://www.heyclicky.com/for-mac">for Mac</a>.
            The GitHub README also lists a Windows download for Windows 10 and 11.
          </p>
        </div>

        <div>
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900">Privacy</h2>
          <p class="mt-3">
            A JPEG of your displays when you ask. Not a continuous recording.
            <a class={link} href="/privacy-first/">How Skilly handles your screen, voice, and data</a>.
          </p>
          <p class="mt-3">
            HeyClicky’s homepage and Mac page both say: we only see your screen when you press the hotkey, and screenshots are never stored. They do keep basic text summaries so HeyClicky has context. You can delete your account and all its data in settings.
            <a class={link} href="https://www.heyclicky.com/">Homepage</a>,
            <a class={link} href="https://www.heyclicky.com/for-mac">for Mac</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-site px-6 pb-16">
      <div class="mx-auto max-w-[760px]" itemscope itemtype="https://schema.org/FAQPage">
        <h2 class="mb-8 text-center text-2xl font-semibold text-gray-900 lg:text-3xl">Common questions</h2>
        <div class="space-y-5">
          <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <h3 class="mb-2 text-lg font-semibold text-gray-900" itemprop="name">Is Skilly open source?</h3>
            <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <p class="text-[15px] leading-relaxed text-gray-700" itemprop="text">Yes. The Mac app is Apache-2.0. The license file is at github.com/tryskilly/skilly LICENSE. The README says it is a fork of github.com/farzaa/clicky, which is MIT.</p>
            </div>
          </div>
          <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <h3 class="mb-2 text-lg font-semibold text-gray-900" itemprop="name">Can I bring my own OpenAI key?</h3>
            <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <p class="text-[15px] leading-relaxed text-gray-700" itemprop="text">Bring your own OpenAI key: $5/month plus your OpenAI usage. The hosted plan is Skilly for People Beta — $19/month, with 3 hours of live AI tutoring per month. 15-minute trial, no card.</p>
            </div>
          </div>
          <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
            <h3 class="mb-2 text-lg font-semibold text-gray-900" itemprop="name">Which creative apps have a bundled skill?</h3>
            <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
              <p class="text-[15px] leading-relaxed text-gray-700" itemprop="text">Premiere Pro, DaVinci Resolve, After Effects, Blender and Figma. Houdini is coming soon and not bundled in the app yet.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-site px-6 pb-16">
      <div class="mx-auto max-w-[680px] rounded-2xl border border-amber-200/60 bg-gradient-to-br from-amber-50 to-white p-10 text-center">
        <h2 class="mb-3 text-2xl font-semibold text-gray-900 lg:text-3xl">Try Skilly on your Mac</h2>
        <p class="mb-6 text-gray-600">15-minute trial, no card. Source on <a href="https://github.com/tryskilly/skilly" class={link}>github.com/tryskilly/skilly</a>.</p>
        <Button
          data-mac-download
          href={trackedDownloadUrl('vs', 'vs_clicky', 'clicky')}
          variant="builders-accent"
          size="xl"
          data-ph-event="web_cta_download_clicked"
          data-ph-prop-location="vs_clicky"
          data-ph-prop-target-funnel="people"
          data-ph-prop-cta-text="Download for Mac"
        >
          Download for Mac
        </Button>
        <Button
          data-waitlist-jump
          href="#get-skilly"
          variant="builders-accent"
          size="xl"
        >
          Join the waitlist
        </Button>
      </div>
    </section>

    <section class="mx-auto max-w-site px-6 pb-20">
      <div class="mx-auto max-w-[960px]">
        <h2 class="mb-4 text-xl font-semibold text-gray-900">More comparisons</h2>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          <a href="/vs/cluely/" class="block rounded-lg border border-gray-200 px-5 py-4 transition-colors hover:border-amber-400 hover:bg-amber-50/40">
            <p class="font-medium text-gray-900">Skilly vs Cluely</p>
            <p class="mt-1 text-sm text-gray-500">Tutor vs meeting coach</p>
          </a>
          <a href="/vs/rewind/" class="block rounded-lg border border-gray-200 px-5 py-4 transition-colors hover:border-amber-400 hover:bg-amber-50/40">
            <p class="font-medium text-gray-900">Skilly vs Rewind</p>
            <p class="mt-1 text-sm text-gray-500">Active tutor vs passive recording</p>
          </a>
          <a href="/vs/raycast-ai/" class="block rounded-lg border border-gray-200 px-5 py-4 transition-colors hover:border-amber-400 hover:bg-amber-50/40">
            <p class="font-medium text-gray-900">Skilly vs Raycast AI</p>
            <p class="mt-1 text-sm text-gray-500">Voice + screen vs command bar</p>
          </a>
          <a href="/vs/gemini-live/" class="block rounded-lg border border-gray-200 px-5 py-4 transition-colors hover:border-amber-400 hover:bg-amber-50/40">
            <p class="font-medium text-gray-900">Skilly vs Gemini Live</p>
            <p class="mt-1 text-sm text-gray-500">Native Mac app vs browser tab</p>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
