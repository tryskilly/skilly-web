---
import Layout from '../layouts/Layout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import Button from './Button.astro';
import type { SeoLandingPage } from '../data/seoLandingPages.ts';

interface Props {
  page: SeoLandingPage;
}

const { page } = Astro.props;
const path = `/${page.group}/${page.slug}`;
const ctaUrl = 'https://studio.tryskilly.app/signup';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: page.title,
  description: page.description,
  url: `https://tryskilly.app${path}`,
  mainEntity: page.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---
<Layout title={page.title} description={page.description} productLine="builders" funnelStage="education">
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </Fragment>
  <Nav />

  <main class="marketing-page overflow-x-clip">
    <section class="marketing-hero relative max-w-site mx-auto px-6">
      <div class="max-w-[840px] mx-auto text-center">
        <p class="marketing-eyebrow mb-4">{page.eyebrow}</p>
        <h1 class="marketing-title text-4xl sm:text-5xl lg:text-[56px] font-bold leading-[1.1] tracking-tight mb-6">
          {page.h1}
        </h1>
        <p class="marketing-copy text-lg lg:text-xl leading-relaxed mb-8 max-w-[700px] mx-auto">{page.intro}</p>
        <Button
          href={ctaUrl}
          variant="builders-accent"
          size="lg"
          data-ph-event="web_cta_builders_signup_clicked"
          data-ph-prop-location={`${page.group}_${page.slug}`}
          data-ph-prop-campaign={page.ctaCampaign}
          data-ph-prop-target-funnel="builders"
          rel="nofollow"
          class="shadow-md hover:shadow-lg"
        >
          Start free in Studio
        </Button>
      </div>
    </section>

    <section class="max-w-site mx-auto px-6 pb-16">
      <div class="max-w-[980px] mx-auto grid lg:grid-cols-[1fr_0.75fr] gap-6 items-start">
        <div class="grid gap-5">
          {page.sections.map((section) => (
            <article class="marketing-card p-7">
              <h2 class="marketing-section-heading text-2xl font-semibold mb-3">{section.heading}</h2>
              <p class="marketing-copy leading-relaxed">{section.body}</p>
            </article>
          ))}
        </div>
        <aside class="marketing-card marketing-card--accent p-7 lg:sticky lg:top-24">
          <p class="marketing-eyebrow mb-4">What Skilly adds</p>
          <ul class="space-y-3">
            {page.bullets.map((item) => (
              <li class="marketing-copy flex gap-3 leading-relaxed">
                <span class="mt-2 block h-2 w-2 rounded-full bg-[var(--marketing-accent)] shrink-0" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </section>

    <section class="max-w-site mx-auto px-6 pb-16">
      <div class="max-w-[760px] mx-auto" itemscope itemtype="https://schema.org/FAQPage">
        <h2 class="marketing-section-heading text-2xl lg:text-3xl font-semibold mb-8 text-center">Common questions</h2>
        <div class="space-y-5">
          {page.faqs.map((faq) => (
            <div class="marketing-card p-6" itemscope itemprop="mainEntity" itemtype="https://schema.org/Question">
              <h3 class="marketing-section-heading text-lg font-semibold mb-2" itemprop="name">{faq.question}</h3>
              <div itemscope itemprop="acceptedAnswer" itemtype="https://schema.org/Answer">
                <p class="marketing-copy leading-relaxed text-[15px]" itemprop="text">{faq.answer}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
