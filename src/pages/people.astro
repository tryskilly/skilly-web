---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SkillyWebWidget from '../components/SkillyWebWidget.astro';
import VideoModal from '../components/VideoModal.astro';
import { BROWSER_EXTENSIONS, DOWNLOAD_URL } from '../data/config.ts';

const DEMO_VIDEO_ID = 'M29K4g5Z_NA';

const faqs = [
  {
    question: 'How long is the free trial?',
    answer: 'Skilly includes 15 minutes of real hosted usage with no card required. Most people know within the first session whether voice guidance and pointing is useful for them.',
  },
  {
    question: 'Which apps does Skilly work with?',
    answer: 'Skilly works in any app on your Mac. It can help without a skill, and app-specific skills make it better by adding lessons, vocabulary, and current documentation.',
  },
  {
    question: 'Can I use Skilly in my browser?',
    answer: 'Yes. Skilly is available as an extension for Google Chrome, Microsoft Edge, and Mozilla Firefox. The extension gives you voice guidance and pointing on the webpage you choose; the Mac app works across desktop applications.',
  },
  {
    question: 'Is Skilly private?',
    answer: 'Skilly streams audio and screenshots only while you are asking for help. Sessions are not retained by Skilly, and OpenAI is not allowed to train on API traffic.',
  },
  {
    question: 'Can I build my own skill?',
    answer: 'Yes. You can create private skills for the tools you want to learn, refine them during lessons, and share or submit the best ones later.',
  },
  {
    question: 'What happens when I hit my hosted minutes?',
    answer: 'Hosted usage pauses until the next cycle. There are no surprise overage charges, and Skilly warns you as you approach the limit.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---
<Layout
  title="Skilly for People - Learn any desktop app by asking out loud"
  description="Skilly is a voice-and-pointer AI tutor for Mac, Chrome, Edge, and Firefox. Ask out loud, hear the answer, and watch Skilly point at what to click."
  productLine="people"
  funnelStage="conversion"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <Nav />
  <main class="overflow-x-clip bg-[#FAF8F4] text-[#1A1714]">
    <div class="sr-only" itemscope itemtype="https://schema.org/SoftwareApplication">
      <h2 itemprop="name">Skilly for People</h2>
      <p itemprop="description">
        Skilly for People is a personal voice-first AI tutor for individual users. It is available as a native macOS app and as browser extensions for Chrome, Edge, and Firefox, with Windows desktop support planned. Users ask out loud, Skilly sees the current screen or chosen webpage, speaks the answer, and points at the exact interface element to use next.
      </p>
      <span itemprop="operatingSystem">macOS 14+, Google Chrome, Microsoft Edge, Mozilla Firefox; Windows desktop planned</span>
      <span itemprop="applicationCategory">EducationalApplication</span>
    </div>

    <section id="top" class="mx-auto max-w-6xl px-5 pb-12 pt-24 sm:px-8 sm:pt-28">
      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_1fr]">
        <div>
          <div class="font-mono text-[12px] tracking-[0.04em] text-[#F50A87]">
            <span class="text-[#1A1714]">[</span>POINT: for-people<span class="text-[#1A1714]">]</span>
          </div>
          <h1 class="mt-5 max-w-[650px] text-[44px] font-bold leading-[1.03] tracking-tight text-[#1A1714] sm:text-[58px]">
            <span class="block">Stop Googling</span>
            <span>"how do I do this?"</span>
          </h1>
          <p class="mt-6 max-w-lg text-[18px] leading-relaxed text-[#6B635A]">
            Skilly is the patient expert sitting next to you. Ask out loud in any Mac app, hear the answer, and watch the cursor move to the exact button, menu, or setting.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={DOWNLOAD_URL}
              data-ph-event="web_cta_download_clicked"
              data-ph-prop-location="people_hero"
              data-ph-prop-target-funnel="people"
              class="inline-flex items-center gap-2 rounded-xl bg-[#F50A87] px-6 py-3.5 font-semibold text-white transition hover:brightness-105"
            >
              <svg width="16" height="16" viewBox="0 0 80 80" fill="white" aria-hidden="true"><path d="M20 8C18 7 16 9 16 11L16 60C16 62 18 64 20 63L34 52C35 51 37 51 38 52L50 66C51 67 53 68 55 67L61 61C63 59 62 57 61 56L49 44C48 43 48 41 49 40L58 38C60 37 61 35 59 34L20 8Z"/></svg>
              Download free
            </a>
            <button
              type="button"
              data-video-modal-open={DEMO_VIDEO_ID}
              data-ph-event="web_demo_video_played"
              data-ph-prop-location="people_hero"
              class="inline-flex items-center rounded-xl border border-[#E8E2D9] bg-white px-5 py-3.5 font-semibold transition hover:border-[#F50A87]/40"
            >
              Watch 90-sec demo
            </button>
          </div>
          <p class="mt-4 text-[13px] text-[#6B635A]">
            15 minutes free · no card · macOS 14+ · free with your own OpenAI key
          </p>
        </div>

        <div id="demo" class="relative scroll-mt-24">
          <div class="absolute -top-3 left-2 z-20 rounded-2xl rounded-bl-sm bg-[#1A1714] px-3.5 py-2 text-[13px] text-[#FAF8F4] shadow-lg">
            <span class="mr-1.5 font-mono text-[10px] tracking-[0.04em] text-[#F50A87]">YOU</span>how do I render this?
          </div>
          <div class="relative mt-8 overflow-hidden rounded-2xl border border-[#E8E2D9] bg-white shadow-xl">
            <div class="flex h-9 items-center gap-1.5 border-b border-[#E8E2D9] bg-[#F2EEE6] px-4">
              <span class="h-2.5 w-2.5 rounded-full bg-[#E8E2D9]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#E8E2D9]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#E8E2D9]"></span>
              <span class="ml-2 font-mono text-[10px] tracking-[0.04em] text-[#6B635A]">Blender</span>
            </div>
            <div class="grid grid-cols-[1fr_auto] gap-4 p-5">
              <div class="space-y-2.5">
                <div class="h-24 rounded-lg bg-[#F2EEE6]"></div>
                <div class="h-3 w-2/3 rounded bg-[#F2EEE6]"></div>
                <div class="h-3 w-1/2 rounded bg-[#F2EEE6]"></div>
              </div>
              <div class="w-28 space-y-2">
                <div class="h-3 rounded bg-[#F2EEE6]"></div>
                <div class="relative">
                  <div class="absolute inset-0 rounded-lg bg-[#F50A87]/25 blur-md"></div>
                  <div class="relative grid h-9 place-items-center rounded-lg border-2 border-[#F50A87] bg-[#F50A87]/10 text-[12px] font-semibold text-[#F50A87]">Render</div>
                </div>
                <div class="h-3 rounded bg-[#F2EEE6]"></div>
              </div>
            </div>
            <div class="people-cursor absolute right-[108px] top-[92px]">
              <svg width="30" height="30" viewBox="0 0 80 80" fill="#2563EB" aria-hidden="true" style="filter:drop-shadow(0 2px 4px rgba(37,99,235,.4))"><path d="M20 8C18 7 16 9 16 11L16 60C16 62 18 64 20 63L34 52C35 51 37 51 38 52L50 66C51 67 53 68 55 67L61 61C63 59 62 57 61 56L49 44C48 43 48 41 49 40L58 38C60 37 61 35 59 34L20 8Z"/></svg>
            </div>
          </div>
          <div class="absolute -bottom-4 right-2 z-20 max-w-[260px] rounded-2xl rounded-br-sm border border-[#E8E2D9] bg-white px-3.5 py-2.5 shadow-lg">
            <div class="mb-1 flex items-center gap-2">
              <span class="font-mono text-[10px] tracking-[0.04em] text-[#2563EB]">SKILLY · 0:02</span>
              <span class="voice-wave flex h-[18px] items-end gap-[2px]" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
            </div>
            <div class="text-[13px] leading-snug">Hit <b class="text-[#F50A87]">Render</b> on the right, or press F12 to render the current frame.</div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-[#E8E2D9] bg-white/70">
      <div class="mx-auto grid max-w-6xl gap-5 px-5 py-8 sm:px-8 md:grid-cols-[1.1fr_1fr] md:items-center">
        <p class="text-[14px] leading-relaxed text-[#6B635A]">
          <strong class="font-semibold text-[#1A1714]">Built for real desktop work.</strong> Native Swift app, OpenAI Realtime voice, visible cursor pointing, and open-source code you can inspect.
        </p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[13px] text-[#6B635A] md:justify-end">
          <span>OpenAI Realtime</span>
          <span>macOS native</span>
          <span>Zero retention</span>
          <a href="https://github.com/tryskilly/skilly" target="_blank" rel="noopener noreferrer" class="font-semibold text-[#1A1714] underline underline-offset-4 decoration-[#F50A87]/30 hover:decoration-[#F50A87]">Open source</a>
        </div>
      </div>
    </section>

    <section id="browser-extensions" class="border-b border-[#E8E2D9] bg-[#FAF8F4]">
      <div class="mx-auto grid max-w-6xl gap-7 px-5 py-12 sm:px-8 md:grid-cols-[1fr_1.35fr] md:items-center">
        <div>
          <div class="font-mono text-[12px] tracking-[0.04em] text-[#F50A87]"><span class="text-[#1A1714]">[</span>POINT: browser<span class="text-[#1A1714]">]</span></div>
          <h2 class="mt-3 text-[28px] font-bold leading-tight tracking-tight sm:text-[34px]">Use Skilly on the web, too.</h2>
          <p class="mt-3 max-w-md text-[15px] leading-relaxed text-[#6B635A]">Install the extension for voice guidance and visible pointing on the webpage you choose. No Mac required.</p>
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
          {BROWSER_EXTENSIONS.map((extension) => (
            <a
              href={extension.href}
              target="_blank"
              rel="noopener noreferrer"
              data-ph-event="web_extension_store_clicked"
              data-ph-prop-store={extension.id}
              data-ph-prop-location="people_browser_section"
              data-ph-prop-target-funnel="people"
              class="group rounded-2xl border border-[#E8E2D9] bg-white p-4 transition hover:-translate-y-0.5 hover:border-[#F50A87]/40 hover:shadow-sm"
            >
              <div class="font-semibold text-[#1A1714]">{extension.name}</div>
              <div class="mt-1 text-[12px] text-[#6B635A]">Add to {extension.shortName} <span aria-hidden="true" class="transition group-hover:translate-x-0.5">→</span></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-[#E8E2D9] bg-white">
      <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
        <div class="mb-6 font-mono text-[12px] tracking-[0.04em] text-[#6B635A]"><span class="text-[#F50A87]">[</span>POINT: the-fix<span class="text-[#F50A87]">]</span></div>
        <div class="grid gap-8 md:grid-cols-3">
          <div class="reveal"><div class="mb-1.5 text-[15px] font-bold">No more tab-switching</div><p class="text-[14px] leading-relaxed text-[#6B635A]">Stop leaving your work to search forums, scrub tutorials, and guess. Ask without breaking focus.</p></div>
          <div class="reveal"><div class="mb-1.5 text-[15px] font-bold">Answers for your screen</div><p class="text-[14px] leading-relaxed text-[#6B635A]">Skilly sees what you see, so it answers about your actual file, not a generic doc that does not match.</p></div>
          <div class="reveal"><div class="mb-1.5 text-[15px] font-bold">Shows, not just tells</div><p class="text-[14px] leading-relaxed text-[#6B635A]">The cursor moves to the exact button while it talks. You watch the step happen instead of decoding directions.</p></div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="mb-4 font-mono text-[12px] tracking-[0.04em] text-[#F50A87]"><span class="text-[#1A1714]">[</span>POINT: create-a-skill<span class="text-[#1A1714]">]</span></div>
      <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.1fr]">
        <div>
          <h2 class="text-[32px] font-bold leading-[1.03] tracking-tight text-[#1A1714] sm:text-[40px]">Want to learn something new? Make a skill for it.</h2>
          <p class="mt-5 max-w-md text-[17px] leading-relaxed text-[#6B635A]">
            Do not know the app yet? That is fine. Name what you want to learn, and Skilly can turn docs and notes into a step-by-step guide you use live.
          </p>
          <ul class="mt-6 space-y-2.5 text-[15px]">
            <li class="flex gap-2.5"><span class="text-[#F50A87]">✓</span> Lands in your library as a private skill</li>
            <li class="flex gap-2.5"><span class="text-[#F50A87]">✓</span> Refine it mid-lesson as you learn</li>
            <li class="flex gap-2.5"><span class="text-[#F50A87]">✓</span> Share by link or submit it to the public library later</li>
          </ul>
          <a href="/tools/skill-builder/" data-ph-event="web_skill_builder_cta_clicked" data-ph-prop-location="people_create_skill" class="mt-7 inline-flex h-12 items-center justify-center rounded-xl bg-[#1A1714] px-6 font-semibold text-white transition hover:bg-black">
            Build a free skill
          </a>
        </div>
        <div class="rounded-3xl border border-[#E8E2D9] bg-white p-6 shadow-sm sm:p-7">
          <div class="mb-4 rounded-xl border border-[#E8E2D9] bg-[#F2EEE6] px-4 py-3 text-[15px]">Teach me to cut a clip in DaVinci Resolve</div>
          <div class="mb-5 space-y-2">
            <div class="flex items-center gap-2.5 text-[13.5px]"><span class="grid h-5 w-5 place-items-center rounded-full bg-[#F50A87]/10 text-[11px] text-[#F50A87]">✓</span> Read product docs and context</div>
            <div class="flex items-center gap-2.5 text-[13.5px]"><span class="grid h-5 w-5 place-items-center rounded-full bg-[#F50A87]/10 text-[11px] text-[#F50A87]">✓</span> Composed the first lessons</div>
            <div class="flex items-center gap-2.5 text-[13.5px]"><span class="grid h-5 w-5 place-items-center rounded-full bg-[#F50A87]/10 text-[11px] text-[#F50A87]">✓</span> Added vocabulary for pointing</div>
          </div>
          <div class="overflow-hidden rounded-xl border border-[#E8E2D9]">
            <div class="flex items-center justify-between border-b border-[#E8E2D9] bg-[#F2EEE6] px-4 py-2.5">
              <span class="text-[14px] font-semibold">DaVinci - Cut a clip</span>
              <span class="rounded border border-[#E8E2D9] bg-white px-2 py-0.5 font-mono text-[10px] tracking-[0.04em] text-[#6B635A]">private</span>
            </div>
            <div class="space-y-1.5 p-4 text-[13px]">
              <div class="flex gap-2"><span class="font-mono text-[#F50A87]">01</span> Import footage to the media pool</div>
              <div class="flex gap-2"><span class="font-mono text-[#F50A87]">02</span> Drop it on the timeline</div>
              <div class="pl-6 font-mono text-[12px] tracking-[0.04em] text-[#6B635A]">+ 4 more</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-[#E8E2D9] bg-white">
      <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
        <div class="mb-4 font-mono text-[12px] tracking-[0.04em] text-[#6B635A]"><span class="text-[#F50A87]">[</span>POINT: skills<span class="text-[#F50A87]">]</span></div>
        <h2 class="mb-2 text-[26px] font-bold leading-tight tracking-tight sm:text-[32px]">Skills that ship free in the app</h2>
        <p class="mb-7 max-w-lg text-[15px] text-[#6B635A]">Full courses with progress tracking and current knowledge from docs, so help can go deeper than generic chat.</p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {['Blender|Modeling, sculpting, rendering', 'Figma|Auto layout, components, prototyping', 'After Effects|Keyframing, effects, text animation', 'DaVinci Resolve|Editing, color, audio, delivery', 'Premiere Pro|Trimming, color, titles, export', 'Houdini|Pyro, FLIP fluids, Karma rendering'].map((item) => {
            const [name, description] = item.split('|');
            return (
              <div class="card-lift rounded-2xl border border-[#E8E2D9] bg-[#FAF8F4] p-5">
                <div class="text-[16px] font-bold">{name}</div>
                <div class="mt-1 text-[13px] text-[#6B635A]">{description}</div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
      <div class="mb-6 font-mono text-[12px] tracking-[0.04em] text-[#6B635A]"><span class="text-[#F50A87]">[</span>POINT: how-it-works<span class="text-[#F50A87]">]</span></div>
      <div class="grid gap-6 md:grid-cols-3">
        <div class="reveal"><div class="mb-2 font-mono text-[28px] font-semibold text-[#F50A87]/40">01</div><h3 class="text-[17px] font-bold">You are stuck in any app</h3><p class="mt-1.5 text-[14px] leading-relaxed text-[#6B635A]">Excel, Notion, Blender, your browser, or a niche professional tool on your Mac.</p></div>
        <div class="reveal"><div class="mb-2 font-mono text-[28px] font-semibold text-[#F50A87]/40">02</div><h3 class="text-[17px] font-bold">Hold the shortcut, talk</h3><p class="mt-1.5 text-[14px] leading-relaxed text-[#6B635A]">Press Ctrl + Option and ask out loud, like you would ask a person sitting beside you.</p></div>
        <div class="reveal"><div class="mb-2 font-mono text-[28px] font-semibold text-[#F50A87]/40">03</div><h3 class="text-[17px] font-bold">Hear it, watch the cursor</h3><p class="mt-1.5 text-[14px] leading-relaxed text-[#6B635A]">Skilly talks you through the answer and points at exactly what to click.</p></div>
      </div>
      <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-[#E8E2D9] pt-6 text-[13px] text-[#6B635A]">
        <span>16 languages, 8 voices</span><span>· OpenAI Realtime</span><span>· Zero retention</span><span>· Open source, Apache-2.0</span><span>· Native Swift, no Electron</span>
      </div>
    </section>

    <section id="pricing" class="scroll-mt-20 border-y border-[#E8E2D9] bg-white">
      <div class="mx-auto max-w-5xl px-5 py-16 sm:px-8 sm:py-20">
        <div class="mb-4 font-mono text-[12px] tracking-[0.04em] text-[#6B635A]"><span class="text-[#F50A87]">[</span>POINT: pricing<span class="text-[#F50A87]">]</span></div>
        <h2 class="mb-2 text-[30px] font-bold leading-tight tracking-tight sm:text-[38px]">Start free. Pay only if it clicks.</h2>
        <p class="mb-9 text-[15px] text-[#6B635A]">The hosted plan is for individual desktop users. Builder pricing lives separately in Studio.</p>
        <div class="grid gap-6 lg:grid-cols-2">
          <div class="rounded-3xl border-2 border-[#F50A87]/25 bg-[#FAF8F4] p-7">
            <div class="mb-2 font-mono text-[11px] tracking-[0.04em] text-[#F50A87]">HOSTED</div>
            <div class="flex items-baseline gap-2"><span class="text-[40px] font-bold leading-none tracking-tight">$19</span><span class="text-[#6B635A]">/month</span></div>
            <p class="mt-2 text-[14px] text-[#6B635A]">Voice minutes hosted for you. 15 minutes free first, no card.</p>
            <ul class="mt-5 space-y-2.5 text-[14px]">
              <li class="flex gap-2.5"><span class="text-[#F50A87]">✓</span> Works in every Mac app</li>
              <li class="flex gap-2.5"><span class="text-[#F50A87]">✓</span> All bundled skills plus build your own</li>
              <li class="flex gap-2.5"><span class="text-[#F50A87]">✓</span> 16 languages, Live Tutor, multi-monitor</li>
              <li class="flex gap-2.5"><span class="text-[#F50A87]">✓</span> Cancel anytime, keep access through the period</li>
            </ul>
            <a href={DOWNLOAD_URL} data-ph-event="web_cta_download_clicked" data-ph-prop-location="people_pricing_hosted" class="mt-7 inline-flex h-12 w-full items-center justify-center rounded-xl bg-[#F50A87] px-5 font-semibold text-white">Start free</a>
          </div>
          <div class="rounded-3xl border border-[#E8E2D9] bg-[#FAF8F4] p-7">
            <div class="mb-2 font-mono text-[11px] tracking-[0.04em] text-[#6B635A]">BRING YOUR OWN KEY</div>
            <div class="flex items-baseline gap-2"><span class="text-[40px] font-bold leading-none tracking-tight">Free</span><span class="text-[#6B635A]">+ OpenAI usage</span></div>
            <p class="mt-2 text-[14px] text-[#6B635A]">Paste your own OpenAI key and skip the hosted trial gate. Pay OpenAI directly, roughly $0.06-0.10/min.</p>
            <ul class="mt-5 space-y-2.5 text-[14px]">
              <li class="flex gap-2.5"><span>✓</span> No subscription or card with Skilly</li>
              <li class="flex gap-2.5"><span>✓</span> Full cost control</li>
              <li class="flex gap-2.5"><span>✓</span> Audit or fork the source</li>
            </ul>
            <a href="https://github.com/tryskilly/skilly" data-ph-event="web_github_clicked" data-ph-prop-location="people_pricing_byok" data-ph-prop-target-funnel="people" class="mt-7 inline-flex h-12 w-full items-center justify-center rounded-xl border border-[#E8E2D9] bg-white px-5 font-semibold transition hover:border-[#F50A87]/40">View on GitHub</a>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-5 py-14 text-center sm:px-8">
      <h2 class="text-[26px] font-bold leading-tight tracking-tight sm:text-[32px]">Not on Mac yet?</h2>
      <p class="mb-6 mt-3 text-[15px] text-[#6B635A]">Use the browser extensions today, or tell us which native platform you want next.</p>
      <div class="flex flex-wrap justify-center gap-2.5">
        <span class="rounded-xl border border-[#E8E2D9] bg-white px-4 py-2 text-[13px]">macOS - available now</span>
        <span class="rounded-xl border border-[#E8E2D9] bg-white px-4 py-2 text-[13px]">Chrome, Edge, Firefox - available now</span>
        <span class="rounded-xl border border-[#E8E2D9] bg-white px-4 py-2 text-[13px] text-[#6B635A]">Windows - in development</span>
        <span class="rounded-xl border border-[#E8E2D9] bg-white px-4 py-2 text-[13px] text-[#6B635A]">Linux - planned</span>
        <span class="rounded-xl border border-[#E8E2D9] bg-white px-4 py-2 text-[13px] text-[#6B635A]">iOS - exploring</span>
      </div>
    </section>

    <section id="faq" class="mx-auto max-w-3xl scroll-mt-20 px-5 py-14 sm:px-8">
