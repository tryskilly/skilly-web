---
// src/pages/learn/index.astro
// /learn hub — lists every published article, grouped by category.
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('learn');
const sorted = entries.sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
);

// Programmatic curriculum split: hubs (one per app) get a featured section,
// per-stage lesson pages (data.series) are reachable via their hub + sitemap
// rather than flooding the flat category grids below. Standalone = hand-written.
const idSlug = (e: (typeof sorted)[number]) => e.id.replace(/\.md$/, '');
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const isHub = (e: (typeof sorted)[number]) => idSlug(e).endsWith('-tutorial-for-beginners');
const hubs = sorted.filter(isHub);
const lessons = sorted.filter((e) => e.data.series && !isHub(e));
const standalone = sorted.filter((e) => !e.data.series && !isHub(e));
const hubAppSlug = (e: (typeof sorted)[number]) => idSlug(e).replace('-tutorial-for-beginners', '');
const lessonCount = (hub: (typeof sorted)[number]) =>
  lessons.filter((l) => slugify(l.data.series ?? '') === hubAppSlug(hub)).length;

const siteUrl = 'https://tryskilly.app';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Skilly Learn — tutorials and guides for AI on Mac',
  description: 'Tutorials, comparisons, and how-to guides for using AI on macOS — from Blender shortcuts to OpenAI Realtime architecture.',
  url: `${siteUrl}/learn/`,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Skilly',
    url: siteUrl,
  },
  hasPart: sorted.map((entry) => ({
    '@type': 'Article',
    headline: entry.data.title,
    url: `${siteUrl}/learn/${entry.id.replace(/\.md$/, '')}/`,
    datePublished: entry.data.pubDate.toISOString(),
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Learn', item: `${siteUrl}/learn/` },
  ],
};

const categoryOrder = ['tutorial', 'how-to', 'comparison', 'concept', 'troubleshooting'];
const categoryLabels: Record<string, string> = {
  tutorial: 'Tutorials',
  'how-to': 'How-to guides',
  comparison: 'Comparisons',
  concept: 'Concepts',
  troubleshooting: 'Troubleshooting',
};

const categories: Record<string, typeof sorted> = {};
for (const entry of standalone) {
  const cat = entry.data.category;
  if (!categories[cat]) categories[cat] = [];
  categories[cat].push(entry);
}

const orderedCategories = categoryOrder
  .filter((c) => categories[c])
  .map((c) => [c, categories[c]] as const);
---
<Layout
  title="Learn — tutorials and guides for AI on Mac | Skilly"
  description="Tutorials, comparisons, and how-to guides for using AI on macOS — from Blender shortcuts to OpenAI Realtime architecture."
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Nav />

  <main class="overflow-x-clip">
    <section class="relative max-w-site mx-auto px-6 pt-32 lg:pt-40 pb-12">
      <div class="max-w-[760px] mx-auto text-center">
        <p class="text-[11px] font-mono tracking-[0.08em] uppercase text-amber-700 mb-4">Skilly Learn</p>
        <h1 class="text-4xl sm:text-5xl lg:text-[56px] font-bold leading-[1.1] tracking-tight text-gray-900 mb-6">
          Tutorials & guides for AI on your Mac.
        </h1>
        <p class="text-lg lg:text-xl leading-relaxed text-gray-600 max-w-[640px] mx-auto">
          Hands-on walkthroughs, honest comparisons, and the occasional deep dive into how voice + screen-aware AI actually works on macOS.
        </p>
      </div>
    </section>

    <section class="max-w-site mx-auto px-6 pb-14">
      <a href="/tools/skill-builder/" data-ph-event="web_skill_builder_cta_clicked" data-ph-prop-location="learn_hub" class="group mx-auto flex max-w-[1040px] flex-col gap-5 rounded-xl border border-amber-500/30 bg-amber-50/50 p-7 transition hover:border-amber-500/60 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-[11px] font-mono font-semibold uppercase tracking-[0.08em] text-amber-700">Free tool</p>
          <h2 class="mt-2 text-xl font-bold text-gray-900">Create a course for the software you want to learn</h2>
          <p class="mt-2 max-w-[680px] text-[15px] leading-relaxed text-gray-600">Generate a personalized learning path sized to your goal—short for a focused task, deeper for a complete project.</p>
        </div>
        <span class="shrink-0 font-semibold text-amber-800 transition group-hover:translate-x-1">Open the AI course generator &rarr;</span>
      </a>
    </section>

    {hubs.length > 0 && (
      <section class="max-w-site mx-auto px-6 pb-6">
        <div class="max-w-[1040px] mx-auto">
          <div class="flex items-baseline justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Course curriculums</h2>
            <span class="text-[11px] font-mono tracking-[0.08em] uppercase text-gray-500">{hubs.length} apps</span>
          </div>
          <p class="text-gray-600 text-[15px] mb-6 max-w-[680px]">Free, step-by-step beginner curriculums for the creative apps Skilly teaches — each one a sequence of hands-on lessons you can follow on your Mac.</p>
          <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
            {hubs.map((hub) => (
              <a
                href={`/learn/${idSlug(hub)}/`}
                class="group p-7 rounded-xl bg-white border border-gray-200 hover:border-amber-500/60 shadow-sm hover:shadow-md transition-all"
              >
                <h3 class="text-[18px] font-semibold text-gray-900 group-hover:text-amber-700 transition-colors leading-snug tracking-tight">{hub.data.title}</h3>
                <p class="mt-2 text-[14px] text-gray-600 leading-relaxed">{hub.data.description}</p>
                <p class="mt-5 text-[11px] font-mono tracking-[0.06em] uppercase text-amber-700">{lessonCount(hub)} lessons &rarr;</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="max-w-site mx-auto px-6 pb-20 lg:pb-24">
      <div class="max-w-[1040px] mx-auto">
        {sorted.length === 0 ? (
          <p class="text-gray-500 text-center py-20">No articles yet. Check back soon.</p>
        ) : (
          <div class="flex flex-col gap-14">
            {orderedCategories.map(([cat, items]) => (
              <section>
                <div class="flex items-baseline justify-between mb-6">
                  <h2 class="text-2xl font-bold text-gray-900 tracking-tight">
                    {categoryLabels[cat] ?? cat}
                  </h2>
                  <span class="text-[11px] font-mono tracking-[0.08em] uppercase text-gray-500">
                    {items.length} {items.length === 1 ? 'article' : 'articles'}
                  </span>
                </div>
                <div class="grid gap-4 md:grid-cols-2">
                  {items.map((entry) => {
                    const slug = entry.id.replace(/\.md$/, '');
                    return (
                      <a
                        href={`/learn/${slug}/`}
                        class="group p-7 rounded-xl bg-white border border-gray-200 hover:border-amber-500/60 shadow-sm hover:shadow-md transition-all"
                      >
                        <h3 class="text-[18px] font-semibold text-gray-900 group-hover:text-amber-700 transition-colors leading-snug tracking-tight">
                          {entry.data.title}
                        </h3>
                        <p class="mt-2 text-[14px] text-gray-600 leading-relaxed">{entry.data.description}</p>
                        <p class="mt-5 text-[11px] font-mono tracking-[0.06em] uppercase text-gray-400">
                          <time datetime={entry.data.pubDate.toISOString()}>
                            {entry.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                          </time>
                        </p>
                      </a>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
