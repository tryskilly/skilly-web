---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Skills from '../components/Skills.astro';
import Pricing from '../components/Pricing.astro';
import Footer from '../components/Footer.astro';
import SkillyWebWidget from '../components/SkillyWebWidget.astro';
import { DOWNLOAD_URL } from '../data/config.ts';
---
<Layout
  title="Skilly for People - Guided skills for learning software"
  description="Skilly for People helps learners use guided skills for creative and professional apps. Ask out loud, get spoken help, and watch Skilly point while you learn."
  productLine="people"
  funnelStage="consideration"
>
  <Nav />
  <main class="overflow-x-clip pt-16">
    <section class="relative px-6 pt-24 pb-16 lg:pt-32 lg:pb-20 bg-[#FAFAF8] overflow-hidden">
      <div class="max-w-site mx-auto grid gap-10 lg:grid-cols-[minmax(0,1fr)_390px] lg:items-center">
        <div>
          <span class="text-[13px] font-semibold text-amber-600 tracking-[1.5px] uppercase">Skilly for people</span>
          <h1 class="mt-4 text-4xl sm:text-5xl lg:text-[64px] font-bold leading-[1.06] tracking-tight text-gray-900">
            Learn the app while you use it.
          </h1>
          <p class="mt-6 max-w-[650px] text-lg lg:text-xl leading-relaxed text-gray-600">
            Skilly turns software learning into guided practice. Start with bundled skills for Blender, Figma, video editing, motion graphics, and VFX, then ask out loud whenever you get stuck.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a href={DOWNLOAD_URL} data-ph-event="web_cta_download_clicked" data-ph-prop-location="people_hero" class="inline-flex items-center justify-center bg-amber-500 hover:bg-amber-600 active:scale-[0.98] text-gray-950 shadow-md hover:shadow-lg rounded-lg px-7 py-3.5 text-[16px] font-semibold transition-all whitespace-nowrap">
              Download the Mac tutor
            </a>
            <a href="#skills" data-ph-event="web_people_skills_clicked" data-ph-prop-location="people_hero" class="inline-flex items-center justify-center border border-gray-300 hover:border-gray-400 bg-white hover:bg-gray-50 active:scale-[0.98] text-gray-800 rounded-lg px-7 py-3.5 text-[16px] font-semibold transition-all whitespace-nowrap">
              Browse skills
            </a>
          </div>
        </div>
        <div class="rounded-[28px] border border-gray-200 bg-white p-6 shadow-xl">
          <div class="space-y-3">
            {['Blender fundamentals', 'Figma auto layout', 'DaVinci color basics', 'Houdini VFX concepts'].map((item, index) => (
              <div class="flex items-center gap-4 rounded-2xl border border-gray-200 bg-gray-50 p-4">
                <div class="grid h-10 w-10 place-items-center rounded-xl bg-amber-500/10 text-amber-700 font-bold">{index + 1}</div>
                <div>
                  <div class="font-bold text-gray-900">{item}</div>
                  <div class="text-sm text-gray-500">Voice guidance, pointer help, progress</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
    <section class="px-6 py-20 bg-white border-y border-gray-200">
      <div class="max-w-site mx-auto grid gap-6 md:grid-cols-3">
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">
          <h2 class="text-xl font-bold tracking-tight text-gray-900">Ask the exact question.</h2>
          <p class="mt-3 text-[15px] leading-relaxed text-gray-600">No more pausing a tutorial and guessing which menu changed. Ask what you are trying to do right now.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">
          <h2 class="text-xl font-bold tracking-tight text-gray-900">See where to click.</h2>
          <p class="mt-3 text-[15px] leading-relaxed text-gray-600">Skilly explains out loud and moves the pointer to the UI element it is talking about.</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-gray-50 p-6">
          <h2 class="text-xl font-bold tracking-tight text-gray-900">Keep learning in context.</h2>
          <p class="mt-3 text-[15px] leading-relaxed text-gray-600">Skills add app-specific vocabulary, docs, and learning stages so help gets better than generic Q&A.</p>
        </div>
      </div>
    </section>
    <Skills />
    <Pricing />
  </main>
  <Footer />
  <SkillyWebWidget />
</Layout>
